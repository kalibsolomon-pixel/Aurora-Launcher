/// A single-color vector icon. Decorative unless given a label.
export component Icon inherits Path {
    in property <string> path;
    in property <color> color: Theme.text-secondary;
    in property <length> size: 20px;
    width: size;
    height: size;
    commands: path;
    fill: color;
    stroke-width: 0px;
    viewbox-width: 24;
    viewbox-height: 24;
    accessible-role: none;
}
