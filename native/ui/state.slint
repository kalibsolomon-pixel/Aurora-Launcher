// The UI state contract. Each launcher domain owns one global; Rust
// controllers (native/src/*.rs) write its `in` properties and handle its
// callbacks. Screens only read these globals and invoke callbacks — they hold
// no launcher authority of their own.
import { Tone } from "components.slint";

export struct InstanceRow {
    id: string,
    name: string,
    subtitle: string,
    letter: string,
    status: string,
    tone: Tone,
    selected: bool,
    // 24×24 SVG path of the instance's Material Symbols icon.
    icon: string,
}

/// One icon in the Material Symbols picker grid.
export struct SymbolCell {
    name: string,
    label: string,
    path: string,
}

export struct BlockerRow {
    code: string,
    message: string,
    action: string,
}

export struct ContentRow {
    is-mod: bool,
    letter: string,
    picture: image,
    has-picture: bool,
    id: string,
    title: string,
    detail: string,
    enabled: bool,
    toggleable: bool,
    removable: bool,
    note: string,
    // Update availability after an explicit check ("" when unchecked).
    update-text: string,
    update-tone: Tone,
    can-update: bool,
    can-unpin: bool,
}

export struct ProjectRow {
    id: string,
    title: string,
    letter: string,
    author: string,
    description: string,
    downloads: string,
    picture: image,
    has-picture: bool,
    installed: bool,
    busy: bool,
}

export struct AccountRow {
    id: string,
    name: string,
    initial: string,
    status: string,
    selected: bool,
    avatar: image,
    has-avatar: bool,
}

export struct Swatch {
    id: string,
    label: string,
    color: color,
}

export struct SkinRow {
    edit-name: string,
    id: string,
    name: string,
    model: string,
    thumb: image,
    has-thumb: bool,
    previewed: bool,
}

export struct CapeRow {
    id: string,
    name: string,
    selected: bool,
    previewed: bool,
    picture: image,
    has-picture: bool,
}

export enum Page { home, instances, discover, skins, settings }

export global Nav {
    in-out property <Page> page: Page.home;
    // The instance workspace is a sub-page of Instances.
    in-out property <bool> workspace-open: false;
    callback navigate(Page);
}

export global Shell {
    in property <bool> loaded: false;
    in property <string> fatal-error;
    in property <string> toast-text;
    in property <Tone> toast-tone: Tone.neutral;
    in property <bool> toast-visible: false;
    in property <string> version;
    callback dismiss-toast();
    callback retry-load();
}

export global Home {
    in property <bool> has-instance: false;
    in property <string> name;
    in property <string> icon;
    in property <string> subtitle;
    in property <string> letter;
    in property <string> status;
    in property <Tone> tone: Tone.neutral;
    in property <[BlockerRow]> blockers;
    in property <bool> can-play: false;
    in property <bool> busy: false;
    in property <bool> running: false;
    in property <bool> checking: false;
    in property <string> play-label: "Play";
    in property <string> progress-text;
    in property <float> progress: -1;
    in property <string> message;
    in property <Tone> message-tone: Tone.neutral;
    in property <[InstanceRow]> instances;
    in property <[string]> instance-names;
    in property <int> instance-index: -1;
    callback select-index(int);
    callback play();
    callback select(string);
    callback blocker-action(string);
    callback refresh();
}

export global Instances {
    callback content-import();
    in property <[InstanceRow]> rows;
    in property <bool> loading: false;
    callback open(string);
    callback create();

    // Workspace header.
    in property <string> id;
    in property <string> name;
    in property <string> icon;
    in property <string> icon-label;
    in property <string> subtitle;
    in property <string> letter;
    in property <string> status;
    in property <Tone> tone: Tone.neutral;
    in property <bool> installing: false;
    in property <bool> selected: false;
    in-out property <int> tab: 0;
    callback tab-changed(int);
    callback play();
    callback make-selected();
    callback open-folder();
    callback close-workspace();

    // Configuration.
    in-out property <string> memory-mib-text: "4096";
    in-out property <float> memory-gib: 4;
    in property <float> memory-max-gib: 16;
    in property <string> memory-hint;
    in-out property <string> jvm-args;
    in-out property <bool> custom-window: false;
    in-out property <string> window-width;
    in-out property <string> window-height;
    in property <bool> config-dirty: false;
    in property <bool> config-busy: false;
    in property <string> config-error;
    callback config-edited();
    callback save-config();
    callback revert-config();

    // Explicitly reviewed Aurora addition/removal on the installed game.
    in property <bool> client-installed: false;
    in property <bool> client-available: false;
    in property <bool> client-busy: false;
    in property <string> client-note;
    callback client-review();
    in-out property <bool> client-review-open: false;
    in property <string> client-review-text;
    in property <bool> client-review-allowed: false;
    callback client-confirm();

    // Health.
    in property <string> health-text;
    in property <Tone> health-tone: Tone.neutral;
    in property <bool> health-busy: false;
    in property <bool> can-repair: false;
    in property <string> runtime-text;
    callback validate();
    callback repair();

    // Content tabs (mods, resource packs, shaders).
    in property <[ContentRow]> content;
    in property <bool> content-loading: false;
    in property <string> content-error;
    in-out property <string> content-filter;
    callback content-filter-changed(string);
    callback content-toggle(string, bool);
    callback content-remove(string, string);
    callback content-open-folder();
    callback content-refresh();
    callback content-discover();

    // Content updates: explicit check, then per-item or all eligible items.
    in property <bool> updates-busy: false;
    in property <string> updates-summary;
    in property <int> updates-count: 0;
    callback check-updates();
    callback update-all();
    callback content-update(string);
    callback content-unpin(string);
    // Review shown only when an update changes dependencies or warns.
    in-out property <bool> update-review-open: false;
    in property <string> update-review-title;
    in property <string> update-review-text;
    callback update-review-confirm();
    callback update-review-dismiss();

    // Game version and loader of an existing instance (saved as a draft,
    // applied by an explicit install).
    in property <[string]> cfg-versions;
    in-out property <int> cfg-version-index: -1;
    in property <[string]> cfg-loaders;
    in-out property <int> cfg-loader-index: -1;
    in property <bool> cfg-loader-kind-enabled: true;
    in property <string> cfg-loader-kind-note;
    in property <bool> cfg-has-loader: false;
    in property <string> cfg-loader-label: "Loader version";
    in property <[string]> cfg-loader-versions;
    in-out property <int> cfg-loader-version-index: 0;
    in property <bool> cfg-loader-loading: false;
    in property <string> cfg-loader-note;
    in property <bool> cfg-needs-install: false;
    callback cfg-platform-changed();
    callback install-configuration();

    // Java: 0 = managed by Aurora, 1 = custom executable (draft until saved).
    in-out property <int> cfg-java-index: 0;
    in-out property <string> cfg-java-path;
    in property <string> cfg-java-status;
    in property <Tone> cfg-java-tone: Tone.neutral;
    in property <bool> cfg-java-busy: false;
    callback cfg-java-changed();
    callback cfg-java-choose();
    callback cfg-java-check();

    // Managed modpack instance updates.
    in property <string> pack-name;
    in property <string> pack-update-text;
    in property <bool> pack-update-busy: false;
    in property <bool> pack-update-available: false;
    callback pack-check-update();
    callback pack-review-update();
    in-out property <bool> pack-review-open: false;
    in property <string> pack-review-text;
    in property <int> pack-review-conflicts: 0;
    in-out property <bool> pack-keep-local: false;
    in property <bool> pack-review-allowed: false;
    callback pack-review-confirm();

    // Rename.
    in-out property <bool> rename-open: false;
    in-out property <string> rename-text;
    in property <string> rename-error;
    callback rename-start();
    callback rename-confirm();
    callback edit-icon();

    // Instance deletion (exact-name confirmation, enforced again in Rust).
    in-out property <bool> delete-open: false;
    in-out property <string> delete-text;
    in property <string> delete-error;
    in property <bool> delete-busy: false;
    callback delete-start();
    callback delete-confirm();

    // Removal confirmation.
    in-out property <bool> remove-open: false;
    in property <string> remove-title;
    in property <string> remove-detail;
    callback remove-confirm();

    // Creation.
    in-out property <bool> create-open: false;
    in-out property <string> create-name;
    in property <[string]> versions;
    in-out property <int> version-index: 0;
    in-out property <bool> include-snapshots: false;
    in property <[string]> loaders: ["Fabric", "Vanilla"];
    in-out property <int> loader-index: 0;
    in-out property <bool> create-aurora: true;
    in property <bool> aurora-available: false;
    in property <string> aurora-note;
    in property <bool> versions-loading: false;
    in property <bool> create-busy: false;
    in property <string> create-progress;
    in property <float> create-fraction: -1;
    in property <string> create-error;
    in property <string> create-icon;
    in property <string> create-icon-label;
    callback create-choose-icon();
    callback create-changed();
    callback create-platform-changed();
    callback snapshots-changed(bool);
    callback create-confirm();
    // Exact loader version: index 0 is the automatic compatible version.
    in property <bool> create-has-loader: false;
    in property <string> create-loader-label: "Loader version";
    in property <[string]> create-loader-versions;
    in-out property <int> create-loader-index: 0;
    in property <bool> create-loader-loading: false;
    in property <string> create-loader-note;
    // Local Modrinth modpack (.mrpack) import.
    in property <bool> pack-import-busy: false;
    callback import-modpack();
}

export global ContentImport {
    in-out property <bool> open: false;
    in property <string> description;
    in property <bool> allowed: false;
    callback confirm();
    callback dismiss();
}

/// The searchable Material Symbols picker. Rust performs the bounded search;
/// the grid renders only the returned cells.
export global IconPicker {
    // Standalone picker (instance creation). The identity dialog embeds the
    // same panel with the rename field.
    in-out property <bool> open: false;
    in-out property <string> query;
    in property <[SymbolCell]> results;
    in property <[string]> categories;
    in-out property <int> category: 0;
    in property <string> chosen;
    in property <string> chosen-path;
    in property <string> chosen-label;
    in property <string> summary;
    callback search(string);
    callback category-changed(int);
    callback choose(string);
    callback reset();
    callback confirm();
    callback cancel();
}

export struct OptionalPackFile { path: string, selected: bool }
export global Discover {
    in property <[string]> category-names: ["All categories"];
    in-out property <int> category-index: 0;
    in-out property <int> sort-index: 1;
    callback filters-changed();
    // Set when the open pack review came from a recognized local .mrpack.
    in property <string> local-pack-note;
    in property <[OptionalPackFile]> optional-files;
    callback toggle-optional(string);
    in-out property <int> kind: 0;
    in-out property <string> query;
    in property <[ProjectRow]> results;
    in property <bool> loading: false;
    in property <string> error;
    in property <bool> has-more: false;
    in property <string> summary;
    in property <[string]> instance-names;
    in-out property <int> instance-index: 0;
    in property <bool> has-instances: false;
    callback search();
    callback kind-changed(int);
    callback instance-changed(int);
    callback install(string);
    callback more();
    in property <bool> can-return: false;
    callback return-to-instance();
    in-out property <bool> details-open: false;
    in property <string> project-title;
    in property <string> project-summary;
    in property <string> compatibility;
    in property <[string]> versions;
    in-out property <int> version-index: -1;
    in-out property <int> pack-mode: 0;
    in property <bool> details-loading: false;
    in property <bool> install-busy: false;
    in property <bool> can-install: false;
    in property <string> detail-error;
    in property <string> review-text;
    in property <string> progress;
    callback details(string);
    callback version-changed();
    callback review();
    callback confirm-install();
    callback close-details();
}

/// The floating custom-accent picker anchored to the "+" swatch. Rust owns
/// HSV/hex conversion and contrast validation (the core appearance rules).
export global AccentPicker {
    in-out property <bool> open: false;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <float> hue;
    in property <float> saturation;
    in property <float> value;
    in property <color> hue-color: #ff0000;
    in property <color> preview: #8b80ff;
    in-out property <string> hex;
    in property <string> message;
    in property <bool> valid: true;
    callback show(length, length);
    callback set-hue(float);
    callback set-sv(float, float);
    callback hex-edited(string);
    callback apply();
    callback cancel();
}

export struct ActivityRow {
    id: int,
    title: string,
    detail: string,
    phase: string,
    message: string,
    tone: Tone,
    can-cancel: bool,
    can-retry: bool,
    running: bool,
}

/// Downloads and installs started from Discover (native/src/activity.rs).
export global Activity {
    in property <[ActivityRow]> rows;
    in property <string> summary;
    in property <int> active: 0;
    in-out property <bool> open: false;
    callback cancel(int);
    callback retry(int);
    callback clear();
}

export global Accounts {
    in-out property <bool> remove-open: false;
    in property <string> remove-label;
    callback confirm-remove();
    in property <[AccountRow]> rows;
    in property <bool> has-account: false;
    in property <string> name;
    in property <string> initial;
    in property <image> avatar;
    in property <bool> has-avatar: false;
    in property <string> status;
    in property <bool> login-busy: false;
    in property <string> login-phase;
    in property <string> error;
    in-out property <bool> dialog-open: false;
    callback open-dialog();
    callback sign-in();
    callback cancel-sign-in();
    callback select(string);
    callback remove(string);
    callback refresh(string);
}

export global Skins {
    callback rename(string, string);
    in property <bool> has-account: false;
    in property <string> account-name;
    in property <image> current;
    in property <bool> has-current: false;
    in property <string> current-model;
    in property <[SkinRow]> presets;
    in property <[CapeRow]> capes;
    in property <bool> loading: false;
    in property <bool> busy: false;
    in property <string> error;
    callback refresh();
    callback save-current();
    callback apply(string);
    callback remove(string);
    callback select-cape(string);
    callback disable-cape();
    in property <image> player;
    in property <string> preview-label;
    in property <string> cape-label;
    in-out property <bool> outer-layers: true;
    callback layers-changed();
    callback rotate(float, float);
    callback zoom(float);
    callback reset-view();
    callback view-back(bool);
    in property <bool> rear-view: false;
    callback preview-skin(string);
    callback preview-cape(string);
    callback preview-current();
    in-out property <bool> apply-open: false;
    in property <string> apply-label;
    callback confirm-apply();
    in-out property <int> import-model: 0;
    callback import-file();
}

export struct SyncChoice { name:string, checked:bool }
export struct SyncOverrideChoice { name:string, mode:int }
export struct SyncConflictRow { label:string, peers:string, resolvable:bool }
export global InstanceSync {
    in property <[SyncChoice]> instances;
    in property <[SyncChoice]> categories;
    in-out property <string> exclusions;
    in-out property <string> selected-paths;
    in property <bool> enabled: false;
    in property <bool> loaded: false;
    in property <bool> busy: false;
    in property <bool> configuration-selected: false;
    in property <string> message;
    callback enable-changed(bool);
    callback participant-changed(int,bool);
    callback category-changed(int,bool);
    callback paths-changed();
    in property <bool> instance-participating: false;
    in property <bool> instance-disabled: false;
    in property <[SyncOverrideChoice]> instance-categories;
    in-out property <string> instance-exclusions;
    callback instance-disabled-changed(bool);
    callback instance-category-changed(int,int);
    callback instance-paths-changed();
    in property <[SyncConflictRow]> conflicts;
    callback resolve-conflict(int,bool);
    callback defer-conflict();
    callback refresh-conflicts();
}

export global Settings {
    in property <[string]> theme-labels;
    in property <[string]> theme-descriptions;
    in-out property <int> theme-index: 0;
    in property <[Swatch]> accents;
    in property <string> accent-id;
    in-out property <bool> reduce-motion: false;
    in property <bool> appearance-busy: false;
    in property <string> appearance-error;
    callback theme-changed(int);
    callback accent-changed(string);
    // The custom swatch shows the saved custom color, or "+" when none.
    in property <bool> has-custom-accent: false;
    in property <color> custom-accent-color;
    callback reduce-motion-changed(bool);
    in property <[string]> background-labels: ["Simple", "Borealis"];
    in property <[string]> background-descriptions: ["Plain surfaces in the selected theme.", "Soft, stylized aurora bands behind translucent surfaces."];
    in-out property <int> background-index: 0;
    callback background-changed(int);

    // Discord Rich Presence (optional; the core worker owns the connection).
    in property <bool> discord-configured: false;
    in property <string> discord-status;
    in property <bool> discord-busy: false;
    in-out property <bool> discord-enabled: false;
    in-out property <bool> discord-instance-name: false;
    in-out property <bool> discord-minecraft-version: false;
    in-out property <bool> discord-platform: false;
    in-out property <bool> discord-aurora-active: false;
    in-out property <bool> discord-elapsed-time: false;
    in-out property <bool> discord-world: false;
    in-out property <bool> discord-server: false;
    in-out property <bool> discord-server-address: false;
    callback discord-changed();
    callback discord-connect();

    in property <bool> shortcuts-supported: false;
    in property <string> desktop-state;
    in property <string> start-menu-state;
    in property <bool> desktop-present: false;
    in property <bool> start-menu-present: false;
    in property <bool> shortcuts-busy: false;
    callback toggle-desktop-shortcut();
    callback create-start-menu-shortcut();
    callback open-launcher-folder();

    in property <string> launcher-update;
    in property <bool> launcher-update-available: false;
    in-out property <bool> launcher-dialog-open: false;
    in property <bool> launcher-ready-to-install: false;
    in property <bool> launcher-update-busy: false;
    in property <string> launcher-update-detail;
    callback review-launcher-update();
    callback download-launcher-update();
    callback install-launcher-update();
    in property <string> client-update;
    in property <bool> update-busy: false;
    callback check-updates();
    in property <bool> client-update-available: false;
    callback review-client-update();
    in-out property <bool> client-dialog-open: false;
    in property <string> client-dialog-title;
    in property <string> client-dialog-detail;
    in property <bool> client-dialog-can-apply: false;
    in property <bool> client-dialog-busy: false;
    callback client-update-apply();

    in property <string> version;
    in property <string> data-root;
    in property <string> renderer;
}

export global Recovery {
    in property <string> title: "Instance recovery";
    in-out property <bool> open: false;
    in property <bool> busy: false;
    in property <bool> allowed: false;
    in property <string> text;
    in property <int> removed-count: 0;
    in-out property <bool> keep-removed: false;
    callback inspect();
    callback confirm();
}
