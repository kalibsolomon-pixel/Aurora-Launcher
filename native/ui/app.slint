import { Recovery } from "state.slint";
// Aurora Launcher native shell: compact navigation, one content region, and
// overlays (dialogs, notifications). Rendering is event-driven: nothing here
// animates while idle.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import {
    Button, ButtonKind, IconButton, Toggle, Checkbox, Dropdown, TextField, Dialog, Toast, Tone,
    Avatar, StatusPill, Spinner, ProgressBar, FocusRing, KeyboardFocus, EmptyState, Divider,
    Tooltip, InstanceIcon, ContentList, ContentRowBackground,
} from "components.slint";
import { BorealisBackdrop } from "borealis.slint";
import { Nav, Page, Shell, Home, Instances, Discover, Accounts, Settings, SettingsSection, Borealis, InstanceSync, SyncChoice, Skins, AccountRow, IconPicker, AccentPicker, Activity, ActivityRow, ContentImport } from "state.slint";
import { IdentityDialog, IconPickerDialog } from "dialogs.slint";
import { AccentPickerPopover } from "popovers.slint";
import { Chrome, TitleBar, DragArea, ResizeEdges } from "chrome.slint";
import { Widgets, WidgetChoice, WidgetLine, WidgetView } from "widgets.slint";
import { HomePage } from "pages/home.slint";
import { InstancesPage, WorkspacePage } from "pages/instances.slint";
import { DiscoverPage } from "pages/discover.slint";
import { SettingsPage } from "pages/settings.slint";
import { SkinsPage } from "pages/skins.slint";

export { Recovery, Theme, Nav, Page, Shell, Home, Instances, Discover, Accounts, Settings, SettingsSection, Borealis, InstanceSync, SyncChoice, Skins, Tone, IconPicker, AccentPicker, Chrome, Widgets, WidgetChoice, WidgetLine, WidgetView, Activity, ActivityRow, ContentImport }

// Sidebar glyphs: the same Material outlines as `Icons`, as SVG images so they
// are rasterized at their exact physical size. Drawn as filled paths at this
// size they showed notched and doubled edges.
global NavGlyphs {
    out property <image> home: @image-url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z'/></svg>");
    out property <image> instances: @image-url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M5.3 21.5Q4.6 21.5 4 21Q3.5 20.4 3.5 19.7V8.5Q3.1 8.3 2.8 7.8Q2.5 7.4 2.5 6.9V4.3Q2.5 3.6 3 3Q3.6 2.5 4.3 2.5H19.7Q20.4 2.5 21 3Q21.5 3.6 21.5 4.3V6.9Q21.5 7.4 21.2 7.8Q20.9 8.3 20.5 8.5V19.7Q20.5 20.4 20 21Q19.4 21.5 18.7 21.5ZM5 8.7V19.6Q5 19.8 5.1 19.9Q5.2 20 5.4 20H18.7Q18.8 20 18.9 19.9Q19 19.8 19 19.7V8.7ZM4.3 7.2H19.7Q19.8 7.2 19.9 7.1Q20 7 20 6.9V4.3Q20 4.2 19.9 4.1Q19.8 4 19.7 4H4.3Q4.2 4 4.1 4.1Q4 4.2 4 4.3V6.9Q4 7 4.1 7.1Q4.2 7.2 4.3 7.2ZM9.2 13.4H14.8V12H9.2ZM12 14.3Q12 14.3 12 14.3Q12 14.3 12 14.3Q12 14.3 12 14.3Q12 14.3 12 14.3Z'/></svg>");
    out property <image> discover: @image-url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 10.9c-.61 0-1.1.49-1.1 1.1s.49 1.1 1.1 1.1c.61 0 1.1-.49 1.1-1.1s-.49-1.1-1.1-1.1zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm2.19 12.19L6 18l3.81-8.19L18 6l-3.81 8.19z'/></svg>");
    out property <image> person: @image-url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>");
    out property <image> settings: @image-url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z'/></svg>");
    out property <image> download: @image-url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z'/></svg>");
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    // Hover or keyboard focus shows the window-level tooltip.
    out property <bool> hinted: touch.has-hover || (focus.has-focus && focus.focus-visible);
    callback activated();
    height: 52px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: active;
    accessible-action-default => { activated(); }
    forward-focus: focus;
    // The glyph starts on a whole physical pixel; the logo row leaves the
    // items on fractional offsets, which smeared every icon edge.
    Image {
        x: round((root.absolute-position.x + (root.width - self.width) / 2) / 1phx) * 1phx - root.absolute-position.x;
        y: round((root.absolute-position.y + (root.height - self.height) / 2) / 1phx) * 1phx - root.absolute-position.y;
        width: 28px;
        height: 28px;
        source: root.icon;
        colorize: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-secondary;
        accessible-role: none;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.pointer-focus(); root.activated(); } }
    focus := KeyboardFocus {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { root.activated(); return accept; }
            reject
        }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: focus.has-focus && focus.focus-visible; }
}

component AccountButton inherits Rectangle {
    out property <bool> hinted: touch.has-hover || (focus.has-focus && focus.focus-visible);
    height: 52px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: Accounts.has-account ? "Account: " + Accounts.name : "Sign in";
    accessible-action-default => { Accounts.open-dialog(); }
    forward-focus: focus;
    if Accounts.has-account: Avatar { initial: Accounts.initial; picture: Accounts.avatar; has-picture: Accounts.has-avatar; size: 32px; }
    if !Accounts.has-account: Image {
        x: round((root.absolute-position.x + (root.width - self.width) / 2) / 1phx) * 1phx - root.absolute-position.x;
        y: round((root.absolute-position.y + (root.height - self.height) / 2) / 1phx) * 1phx - root.absolute-position.y;
        width: 28px;
        height: 28px;
        source: NavGlyphs.person;
        colorize: touch.has-hover ? Theme.text : Theme.text-secondary;
        accessible-role: none;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.pointer-focus(); Accounts.open-dialog(); } }
    focus := KeyboardFocus {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { Accounts.open-dialog(); return accept; }
            reject
        }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: focus.has-focus && focus.focus-visible; }
}

/// One download/install in the Downloads panel.
component ActivityLine inherits ContentRowBackground {
    in property <ActivityRow> item;
    height: layout.preferred-height;
    if !root.last-row: Rectangle {
        x: 10px;
        y: parent.height - 1px;
        width: parent.width - 20px;
        height: 1px;
        background: Theme.border;
    }
    accessible-role: list-item;
    accessible-label: root.item.title + ", " + root.item.phase;
    accessible-description: root.item.message;
    layout := HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.item.title; color: Theme.text; font-size: Theme.text-body; font-weight: 600; overflow: elide; }
            if root.item.detail != "": Text { text: root.item.detail; color: Theme.text-muted; font-size: Theme.text-metadata; overflow: elide; }
            Text { text: root.item.message; color: root.item.tone == Tone.error ? Theme.error : Theme.text-secondary; font-size: Theme.text-metadata; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                if root.item.running: Spinner { y: (parent.height - self.height) / 2; size: 14px; }
                StatusPill { text: root.item.phase; tone: root.item.tone; }
            }
            if root.item.can-cancel: Button { text: "Cancel"; compact: true; kind: ButtonKind.ghost; clicked => { Activity.cancel(root.item.id); } }
            if root.item.can-retry: Button { text: "Retry"; icon: Icons.refresh; compact: true; clicked => { Activity.retry(root.item.id); } }
        }
    }
}

component AccountLine inherits ContentRowBackground {
    in property <AccountRow> item;
    height: 56px;
    hovered: touch.has-hover;
    if !root.last-row: Rectangle {
        x: 56px;
        y: parent.height - 1px;
        width: parent.width - self.x - 8px;
        height: 1px;
        background: Theme.border;
    }
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-description: root.item.status;
    accessible-item-selected: root.item.selected;
    touch := TouchArea { mouse-cursor: pointer; clicked => { if (!root.item.selected) { Accounts.select(root.item.id); } } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        Avatar { y: (parent.height - self.height) / 2; initial: root.item.initial; picture: root.item.avatar; has-picture: root.item.has-avatar; size: 32px; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.item.name; color: root.item.selected ? Theme.accent : Theme.text-secondary; font-size: Theme.text-body; font-weight: 600; overflow: elide; }
            Text { text: root.item.status; color: Theme.text-muted; font-size: Theme.text-metadata; overflow: elide; }
        }
        if !root.item.selected: Button { y: (parent.height - self.height) / 2; text: "Use"; compact: true; clicked => { Accounts.select(root.item.id); } }
        IconButton { y: (parent.height - self.height) / 2; icon: Icons.logout; label: "Sign out " + root.item.name; clicked => { Accounts.remove(root.item.id); } }
    }
}

export component AppWindow inherits Window {
    in property <string> window-title: "Aurora Launcher";
    title: window-title;
    // Windows: frameless, with the themed caption strip below. The title
    // still names the window for the taskbar and assistive technology.
    no-frame: Chrome.custom;
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 720px;
    min-height: 520px;
    background: Theme.background;
    default-font-size: 14px;
    default-font-family: "Segoe UI";

    // Static dark base plus four curved aurora bands, each blurred once when
    // the assets were generated (no runtime blur). Rust moves, turns and
    // stretches the bands from one stoppable phase source; motion 0, hidden
    // windows and software rendering keep the all-zero rest pose. Each band
    // overscans the window (with a height term for tall windows) so its ends
    // never enter view; borealis.rs tests that bound.
    if Theme.borealis: BorealisBackdrop { area-width: root.width; area-height: root.height; }

    HorizontalLayout {
        Rectangle {
            width: Chrome.sidebar-width;
            background: Theme.sidebar;
            accessible-role: tab-list;
            accessible-label: "Navigation";
            VerticalLayout {
                padding: 10px;
                padding-top: 16px;
                spacing: 6px;
                Rectangle {
                    height: 54px * 512 / 640;
                    // The logo area also moves the window.
                    DragArea { }
                    HorizontalLayout {
                        alignment: center;
                        // 150% of the former 36 px mark, from a pre-rasterized
                        // texture so it stays crisp at high display scales.
                        Image { source: @image-url("../assets/aurora-mark-216.png"); width: 54px; height: 54px * 512 / 640; image-rendering: smooth; accessible-role: image; accessible-label: "Aurora"; }
                    }
                }
                Rectangle { height: 18px; }
                home-nav := NavItem { label: "Home"; icon: NavGlyphs.home; active: Nav.page == Page.home; activated => { Nav.navigate(Page.home); } }
                instances-nav := NavItem { label: "Instances"; icon: NavGlyphs.instances; active: Nav.page == Page.instances; activated => { Nav.navigate(Page.instances); } }
                discover-nav := NavItem { label: "Discover"; icon: NavGlyphs.discover; active: Nav.page == Page.discover; activated => { Nav.navigate(Page.discover); } }
                skins-nav := NavItem { label: "Skins"; icon: NavGlyphs.person; active: Nav.page == Page.skins; activated => { Nav.navigate(Page.skins); } }
                settings-nav := NavItem { label: "Settings"; icon: NavGlyphs.settings; active: Nav.page == Page.settings; activated => { Nav.navigate(Page.settings); } }
                Rectangle { vertical-stretch: 1; }
                downloads-nav := NavItem {
                    label: Activity.active > 0 ? "Downloads (" + Activity.active + " active)" : "Downloads";
                    icon: NavGlyphs.download;
                    active: Activity.open || Activity.active > 0;
                    activated => { Activity.open = !Activity.open; }
                    if Activity.active > 0: Rectangle {
                        x: parent.width / 2 + 6px;
                        y: 10px;
                        width: max(16px, count.preferred-width + 8px);
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.accent;
                        count := Text { text: Activity.active; color: Theme.accent-contrast; font-size: 10px; font-weight: 700; }
                    }
                }
                account-trigger := AccountButton { }
            }
        }
        VerticalLayout {
        horizontal-stretch: 1;
        if Chrome.custom: TitleBar { }
        Rectangle {
            vertical-stretch: 1;
            if !Shell.loaded && Shell.fatal-error == "": HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Spinner { size: 28px; } } }
            if Shell.fatal-error != "": EmptyState {
                icon: Icons.warning;
                title: "Aurora could not load its launcher state";
                message: Shell.fatal-error;
                HorizontalLayout { alignment: center; Button { text: "Try again"; clicked => { Shell.retry-load(); } } }
            }
            if Shell.loaded && Nav.page == Page.home: HomePage { }
            if Shell.loaded && Nav.page == Page.instances && !Nav.workspace-open: InstancesPage { }
            if Shell.loaded && Nav.page == Page.instances && Nav.workspace-open: WorkspacePage { }
            if Shell.loaded && Nav.page == Page.discover: DiscoverPage { }
            if Shell.loaded && Nav.page == Page.skins: SkinsPage { }
            if Shell.loaded && Nav.page == Page.settings: SettingsPage { }
        }
        }
    }

    // Sidebar tooltips live at window level so content never covers them;
    // they have no input handlers and never take a click.
    property <string> nav-tip: home-nav.hinted ? "Home" : instances-nav.hinted ? "Instances" : discover-nav.hinted ? "Discover" : skins-nav.hinted ? "Skins" : settings-nav.hinted ? "Settings" : downloads-nav.hinted ? downloads-nav.label : account-trigger.hinted ? (Accounts.has-account ? Accounts.name : "Sign in") : "";
    property <length> nav-tip-center: home-nav.hinted ? home-nav.absolute-position.y + home-nav.height / 2 : instances-nav.hinted ? instances-nav.absolute-position.y + instances-nav.height / 2 : discover-nav.hinted ? discover-nav.absolute-position.y + discover-nav.height / 2 : skins-nav.hinted ? skins-nav.absolute-position.y + skins-nav.height / 2 : settings-nav.hinted ? settings-nav.absolute-position.y + settings-nav.height / 2 : downloads-nav.hinted ? downloads-nav.absolute-position.y + downloads-nav.height / 2 : account-trigger.absolute-position.y + account-trigger.height / 2;
    if nav-tip != "" && !Accounts.dialog-open: Tooltip {
        x: Chrome.sidebar-width + 6px;
        y: max(4px, min(root.height - self.height - 4px, root.nav-tip-center - self.height / 2));
        text: root.nav-tip;
    }

    if Shell.toast-visible: Toast {
        // A single bounded notification, inside this window (logical pixels).
        // On Discover leave the centered pagination action clear even at 720px.
        available-width: Nav.page == Page.discover ? min(560px, (root.width - Chrome.sidebar-width) / 2 - 80px) : min(560px, root.width - Chrome.sidebar-width - 2 * Theme.space-4);
        x: root.width - self.width - Theme.space-4;
        y: root.height - self.height - Theme.space-4;
        text: Shell.toast-text;
        tone: Shell.toast-tone;
        dismissed => { Shell.dismiss-toast(); }
    }

    if Skins.apply-open: Dialog {
        title: "Apply skin";
        dismissed => { Skins.apply-open = false; }
        Text { text: Skins.apply-label; color: Theme.text-secondary; wrap: word-wrap; }
        HorizontalLayout { alignment: end; spacing: 8px; Button { text: "Cancel"; clicked => { Skins.apply-open = false; } } Button { text: "Apply to account"; kind: ButtonKind.primary; enabled: !Skins.busy; clicked => { Skins.confirm-apply(); } } }
    }

    if Discover.details-open: Dialog {
        title: Discover.project-title;
        dialog-width: 640px;
        dismissible: !Discover.install-busy;
        dismissed => { Discover.close-details(); }
        ScrollView {
            height: min(350px, max(100px, root.height - 310px));
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                if Discover.local-pack-note != "": Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius-md;
                    VerticalLayout { padding: 10px; Text { text: Discover.local-pack-note; color: Theme.text; wrap: word-wrap; font-size: Theme.text-secondary-size; } }
                }
                Text { text: Discover.project-summary; color: Theme.text-secondary; wrap: word-wrap; }
                Text { text: Discover.compatibility; color: Theme.text-muted; wrap: word-wrap; font-size: Theme.text-metadata; }
                if Discover.kind == 3: Text { text: "Pack version"; color: Theme.text-muted; font-size: Theme.text-metadata; }
                Dropdown { label: Discover.kind == 3 ? "Pack version" : "Project version"; model: Discover.versions; current-index <=> Discover.version-index; enabled: !Discover.install-busy && !Discover.details-loading; selected => { Discover.version-changed(); } }
                if Discover.version-detail != "": Text { text: Discover.version-detail; color: Theme.text-secondary; wrap: word-wrap; font-size: Theme.text-secondary-size; }
                if Discover.version-problem != "": Text { text: Discover.version-problem; color: Theme.warning; wrap: word-wrap; font-size: Theme.text-secondary-size; }
                if Discover.kind == 3 && Discover.version-installable: Text { text: "Destination"; color: Theme.text-muted; font-size: Theme.text-metadata; }
                if Discover.kind == 3 && Discover.version-installable: Dropdown { label: "Destination"; model: ["New instance", "Add to an existing instance"]; current-index <=> Discover.pack-mode; enabled: !Discover.install-busy && !Discover.details-loading; selected => { Discover.destination-mode-changed(); } }
                if Discover.kind == 3 && Discover.version-installable && Discover.pack-mode == 1: VerticalLayout {
                    spacing: 6px;
                    if Discover.destinations-note != "": Text { text: Discover.destinations-note; color: Theme.text-muted; wrap: word-wrap; font-size: Theme.text-metadata; }
                    for row[i] in Discover.destinations: VerticalLayout {
                        spacing: 0px;
                        Checkbox {
                            text: row.name;
                            checked: row.selected;
                            enabled: row.compatible && !Discover.details-loading && !Discover.install-busy;
                            toggled => { Discover.choose-destination(i); }
                        }
                        HorizontalLayout { padding-left: 28px; Text { text: row.detail; color: row.compatible ? Theme.text-muted : Theme.warning; wrap: word-wrap; font-size: Theme.text-metadata; } }
                    }
                }
                if Discover.review-facts.length > 0: Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius-md;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        for fact in Discover.review-facts: HorizontalLayout {
                            spacing: 12px;
                            Text { width: 120px; text: fact.label; color: Theme.text-muted; font-size: Theme.text-secondary-size; }
                            Text { horizontal-stretch: 1; text: fact.value; color: Theme.text; wrap: word-wrap; font-size: Theme.text-secondary-size; }
                        }
                    }
                }
                if Discover.review-text != "": Text { text: Discover.review-text; color: Theme.text-secondary; wrap: word-wrap; font-size: Theme.text-secondary-size; }
                for file in Discover.optional-files: Checkbox {
                    text: file.path;
                    checked: file.selected;
                    enabled: !Discover.details-loading && !Discover.install-busy;
                    toggled => { Discover.toggle-optional(file.path); }
                }
                if Discover.detail-error != "": Text { text: Discover.detail-error; color: Theme.error; wrap: word-wrap; }
            }
        }
        if Discover.details-loading: VerticalLayout {
            spacing: 6px;
            HorizontalLayout { spacing: 8px; Spinner { } Text { horizontal-stretch: 1; text: Discover.review-progress != "" ? Discover.review-progress : "Loading…"; color: Theme.text-secondary; wrap: word-wrap; } }
            if Discover.review-fraction >= 0: ProgressBar { progress: Discover.review-fraction; label: Discover.review-progress; }
        }
        if Discover.progress != "": Text { text: Discover.progress; color: Theme.text-secondary; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Close"; enabled: !Discover.install-busy; clicked => { Discover.close-details(); } }
            if Discover.details-loading && Discover.review-cancellable: Button { text: "Cancel review"; clicked => { Discover.cancel-review(); } }
            Button { text: "Review installation"; enabled: Discover.can-review && !Discover.details-loading && !Discover.install-busy; clicked => { Discover.review(); } }
            Button { text: Discover.confirm-label; kind: ButtonKind.primary; enabled: Discover.can-install; loading: Discover.install-busy; clicked => { Discover.confirm-install(); } }
        }
    }

    if Settings.launcher-dialog-open: Dialog {
        title: "Aurora Launcher update";
        dismissible: !Settings.launcher-update-busy;
        dismissed => { Settings.launcher-dialog-open = false; }
        Text { text: Settings.launcher-update-detail; color: Theme.text-secondary; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Close"; enabled: !Settings.launcher-update-busy; clicked => { Settings.launcher-dialog-open = false; } }
            if !Settings.launcher-ready-to-install: Button { text: "Download and verify"; kind: ButtonKind.primary; loading: Settings.launcher-update-busy; clicked => { Settings.download-launcher-update(); } }
            if Settings.launcher-ready-to-install: Button { text: "Exit and install"; kind: ButtonKind.primary; loading: Settings.launcher-update-busy; clicked => { Settings.install-launcher-update(); } }
        }
    }

    if Accounts.dialog-open: Dialog {
        title: "Accounts";
        sidebar-anchored: true;
        dialog-width: 460px;
        dismissed => { Accounts.dialog-open = false; }
        Text {
            text: "Sign-in happens on Microsoft's website in your browser. Aurora never sees your password and keeps only a refresh credential in Windows Credential Manager.";
            color: Theme.text-secondary;
            font-size: Theme.text-secondary-size;
            wrap: word-wrap;
        }
        ScrollView {
            height: min(Accounts.rows.length * 56px, min(240px, max(0px, root.height - 320px)));
            ContentList {
                for row[index] in Accounts.rows: AccountLine {
                    item: row;
                    first-row: index == 0;
                    last-row: index == Accounts.rows.length - 1;
                }
            }
        }
        if Accounts.login-busy: HorizontalLayout {
            spacing: 10px;
            Spinner { y: (parent.height - self.height) / 2; size: 18px; }
            Text { horizontal-stretch: 1; text: Accounts.login-phase; color: Theme.text-secondary; vertical-alignment: center; wrap: word-wrap; }
        }
        if Accounts.error != "": Text { text: Accounts.error; color: Theme.error; wrap: word-wrap; font-size: Theme.text-secondary-size; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if Accounts.login-busy: Button { text: "Cancel sign-in"; clicked => { Accounts.cancel-sign-in(); } }
            if !Accounts.login-busy: Button { text: Accounts.rows.length == 0 ? "Sign in with Microsoft" : "Add account"; icon: Icons.open-external; kind: ButtonKind.primary; clicked => { Accounts.sign-in(); } }
        }
    }

    if Recovery.open: Dialog {
        title: Recovery.title;
        dismissed => { if !Recovery.busy { Recovery.open = false; } }
        ScrollView {
            height: min(300px, max(120px, root.height - 280px));
            VerticalLayout {
                padding-right: 8px;
                Text { text: Recovery.text; color: Theme.text-secondary; wrap: word-wrap; font-size: Theme.text-secondary-size; }
            }
        }
        if Recovery.removed-count > 0: Checkbox {
            text: "Keep the " + Recovery.removed-count + " listed mod(s) removed";
            checked <=> Recovery.keep-removed;
            enabled: !Recovery.busy;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Close"; enabled: !Recovery.busy; clicked => { Recovery.open = false; } }
            Button { text: "Apply safe recovery"; kind: ButtonKind.primary; loading: Recovery.busy; enabled: Recovery.allowed && !Recovery.busy && (Recovery.removed-count == 0 || Recovery.keep-removed); clicked => { Recovery.confirm(); } }
        }
    }

    if Instances.update-review-open: Dialog {
        title: Instances.update-review-title;
        dismissed => { Instances.update-review-dismiss(); }
        ScrollView {
            height: min(300px, max(120px, root.height - 240px));
            VerticalLayout {
                padding-right: 8px;
                Text { text: Instances.update-review-text; color: Theme.text-secondary; font-size: Theme.text-secondary-size; wrap: word-wrap; }
            }
        }
        HorizontalLayout { alignment: end; spacing: 8px;
            Button { text: "Cancel"; clicked => { Instances.update-review-dismiss(); } }
            Button { text: "Update"; kind: ButtonKind.primary; clicked => { Instances.update-review-confirm(); } }
        }
    }

    if Instances.client-review-open: Dialog {
        title: Instances.client-installed ? "Remove Aurora Client" : "Add Aurora Client";
        dismissed => { Instances.client-review-open = false; }
        ScrollView {
            height: min(300px, root.height * 0.45);
            VerticalLayout {
                padding: 4px;
                Text { text: Instances.client-review-text; color: Theme.text-secondary; wrap: word-wrap; font-size: Theme.text-secondary-size; }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { Instances.client-review-open = false; } }
            Button { text: Instances.client-installed ? "Remove" : "Install"; kind: ButtonKind.primary; enabled: Instances.client-review-allowed && !Instances.client-busy; clicked => { Instances.client-confirm(); } }
        }
    }

    if Instances.pack-review-open: Dialog {
        title: "Review modpack update";
        dismissed => { Instances.pack-review-open = false; }
        ScrollView {
            height: min(300px, max(120px, root.height - 260px));
            VerticalLayout {
                padding-right: 8px;
                Text { text: Instances.pack-review-text; color: Theme.text-secondary; font-size: Theme.text-secondary-size; wrap: word-wrap; }
            }
        }
        if Instances.pack-review-conflicts > 0: Checkbox {
            text: "Keep my local copies of the " + Instances.pack-review-conflicts + " changed file(s)";
            checked <=> Instances.pack-keep-local;
        }
        HorizontalLayout { alignment: end; spacing: 8px;
            Button { text: "Cancel"; clicked => { Instances.pack-review-open = false; } }
            Button {
                text: "Update modpack";
                kind: ButtonKind.primary;
                enabled: Instances.pack-review-allowed && (Instances.pack-review-conflicts == 0 || Instances.pack-keep-local);
                clicked => { Instances.pack-review-confirm(); }
            }
        }
    }

    if ContentImport.open: Dialog {
        title: "Review local import";
        dismissed => { ContentImport.dismiss(); }
        local-review := ScrollView {
            height: min(300px, max(120px, root.height - 240px));
            VerticalLayout {
                width: local-review.visible-width;
                alignment: start;
                Text { text: ContentImport.description; color: Theme.text-secondary; font-size: Theme.text-secondary-size; wrap: word-wrap; }
            }
        }
        HorizontalLayout { alignment: end; spacing: 8px;
            Button { text: "Cancel"; clicked => { ContentImport.dismiss(); } }
            Button { text: "Install reviewed file"; kind: ButtonKind.primary; enabled: ContentImport.allowed; clicked => { ContentImport.confirm(); } }
        }
    }

    if Accounts.remove-open: Dialog {
        title: "Remove preview account";
        dismissed => { Accounts.remove-open = false; }
        Text { text: Accounts.remove-label; color: Theme.text-secondary; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { Accounts.remove-open = false; } }
            Button { text: "Remove account"; kind: ButtonKind.danger; clicked => { Accounts.confirm-remove(); } }
        }
    }

    if Activity.open: Dialog {
        title: "Downloads";
        sidebar-anchored: true;
        dialog-width: 460px;
        dismissed => { Activity.open = false; }
        if Activity.summary != "": Text { text: Activity.summary; color: Theme.text-secondary; font-size: Theme.text-secondary-size; wrap: word-wrap; }
        if Activity.rows.length == 0: Text { text: "Installs you start from Discover appear here. Several can run at once; installs into the same instance take turns."; color: Theme.text-muted; font-size: Theme.text-metadata; wrap: word-wrap; }
        if Activity.rows.length > 0: activity-scroll := ScrollView {
            height: min(activity-list.preferred-height, min(380px, max(120px, root.height - 260px)));
            content-width: self.visible-width;
            content-height: activity-list.preferred-height;
            activity-list := ContentList {
                width: activity-scroll.visible-width;
                height: self.preferred-height;
                for row[index] in Activity.rows: ActivityLine {
                    item: row;
                    first-row: index == 0;
                    last-row: index == Activity.rows.length - 1;
                }
            }
        }
        if Activity.rows.length > Activity.active: HorizontalLayout {
            alignment: end;
            Button { text: "Clear finished"; kind: ButtonKind.ghost; compact: true; enabled: Activity.rows.length > Activity.active; clicked => { Activity.clear(); } }
        }
    }

    if Instances.create-open: Dialog {
        title: "New instance";
        dialog-width: 520px;
        dismissible: !Instances.create-busy;
        dismissed => { Instances.create-open = false; }
        Text { text: "Name and icon"; color: Theme.text-secondary; font-size: Theme.text-metadata; }
        HorizontalLayout {
            spacing: Theme.space-3;
            Rectangle {
                width: 40px;
                height: 40px;
                accessible-role: button;
                accessible-label: "Choose icon: " + Instances.create-icon-label;
                accessible-action-default => { Instances.create-choose-icon(); }
                InstanceIcon { path: Instances.create-icon; size: 40px; active: icon-touch.has-hover; }
                icon-touch := TouchArea { mouse-cursor: pointer; enabled: !Instances.create-busy; clicked => { Instances.create-choose-icon(); } }
            }
            TextField { horizontal-stretch: 1; label: "Instance name"; placeholder: "My instance"; text <=> Instances.create-name; max-length: 64; enabled: !Instances.create-busy; }
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: "Minecraft version"; color: Theme.text-secondary; font-size: Theme.text-metadata; }
                Dropdown {
                    label: "Minecraft version";
                    model: Instances.versions;
                    current-index <=> Instances.version-index;
                    enabled: !Instances.create-busy && !Instances.versions-loading && Instances.versions.length > 0;
                    placeholder: Instances.versions-loading ? "Loading…" : "Unavailable";
                    selected => { Instances.create-platform-changed(); }
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: "Loader"; color: Theme.text-secondary; font-size: Theme.text-metadata; }
                Dropdown {
                    width: 150px;
                    label: "Mod loader";
                    model: Instances.loaders;
                    current-index <=> Instances.loader-index;
                    enabled: !Instances.create-busy;
                    selected => { Instances.create-platform-changed(); }
                }
            }
        }
        if Instances.create-has-loader: VerticalLayout {
            spacing: 4px;
            Text { text: Instances.create-loader-label; color: Theme.text-secondary; font-size: Theme.text-metadata; }
            Dropdown {
                label: Instances.create-loader-label;
                model: Instances.create-loader-versions;
                current-index <=> Instances.create-loader-index;
                enabled: !Instances.create-busy && !Instances.create-loader-loading;
                placeholder: "Loading…";
                selected => { Instances.create-changed(); }
            }
            if Instances.create-loader-note != "": Text { text: Instances.create-loader-note; color: Theme.text-muted; font-size: Theme.text-metadata; wrap: word-wrap; }
        }
        Checkbox { text: "Include snapshots"; checked <=> Instances.include-snapshots; enabled: !Instances.create-busy; toggled(value) => { Instances.snapshots-changed(value); } }
        HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: "Aurora Client"; color: Theme.text; font-size: Theme.text-body; }
                Text { text: Instances.aurora-note; color: Theme.text-muted; font-size: Theme.text-metadata; wrap: word-wrap; }
            }
            Toggle {
                y: (parent.height - self.height) / 2;
                label: "Install Aurora Client";
                checked <=> Instances.create-aurora;
                enabled: Instances.aurora-available && !Instances.create-busy;
            }
        }
        if Instances.create-busy: VerticalLayout {
            spacing: 6px;
            Text { text: Instances.create-progress; color: Theme.text-secondary; font-size: Theme.text-metadata; }
            ProgressBar { progress: Instances.create-fraction; label: Instances.create-progress; }
        }
        if Instances.create-error != "": Text { text: Instances.create-error; color: Theme.error; wrap: word-wrap; font-size: Theme.text-secondary-size; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: ButtonKind.ghost; enabled: !Instances.create-busy; clicked => { Instances.create-open = false; } }
            Button {
                text: "Create and install";
                kind: ButtonKind.primary;
                loading: Instances.create-busy;
                enabled: Instances.versions.length > 0;
                clicked => { Instances.create-confirm(); }
            }
        }
    }

    if Instances.rename-open: IdentityDialog { }

    if Settings.client-dialog-open: Dialog {
        title: Settings.client-dialog-title;
        dialog-width: 480px;
        dismissible: !Settings.client-dialog-busy;
        dismissed => { Settings.client-dialog-open = false; }
        Text { text: Settings.client-dialog-detail; color: Theme.text-secondary; font-size: Theme.text-secondary-size; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: ButtonKind.ghost; enabled: !Settings.client-dialog-busy; clicked => { Settings.client-dialog-open = false; } }
            Button { text: "Update"; kind: ButtonKind.primary; enabled: Settings.client-dialog-can-apply; loading: Settings.client-dialog-busy; clicked => { Settings.client-update-apply(); } }
        }
    }

    if Instances.delete-open: Dialog {
        title: "Delete " + Instances.name + "?";
        dialog-width: 460px;
        dismissible: !Instances.delete-busy;
        dismissed => { Instances.delete-open = false; }
        Text { text: "This permanently deletes the instance folder, including worlds and screenshots. It cannot be undone. Type the instance name to confirm."; color: Theme.text-secondary; font-size: Theme.text-secondary-size; wrap: word-wrap; }
        TextField { label: "Type the instance name to confirm"; placeholder: Instances.name; text <=> Instances.delete-text; enabled: !Instances.delete-busy; initial-focus: true; }
        if Instances.delete-error != "": Text { text: Instances.delete-error; color: Theme.error; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: ButtonKind.ghost; enabled: !Instances.delete-busy; clicked => { Instances.delete-open = false; } }
            Button { text: "Delete permanently"; kind: ButtonKind.danger; loading: Instances.delete-busy; enabled: Instances.delete-text == Instances.name; clicked => { Instances.delete-confirm(); } }
        }
    }

    if IconPicker.open: IconPickerDialog { }

    if AccentPicker.open: AccentPickerPopover { }

    if Chrome.custom && !Chrome.maximized: ResizeEdges { }

    if Instances.remove-open: Dialog {
        title: Instances.remove-title;
        dialog-width: 420px;
        dismissed => { Instances.remove-open = false; }
        Text { text: Instances.remove-detail; color: Theme.text-secondary; font-size: Theme.text-secondary-size; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: ButtonKind.ghost; clicked => { Instances.remove-open = false; } }
            Button { text: "Remove"; kind: ButtonKind.danger; icon: Icons.delete; clicked => { Instances.remove-confirm(); } }
        }
    }
}
