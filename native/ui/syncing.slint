import { Theme } from "theme.slint";
import { Group, SettingRow, Toggle, Checkbox, TextField, Label } from "components.slint";
import { InstanceSync } from "state.slint";
import { ListView } from "std-widgets.slint";
export component SyncSettings inherits Group {
    title: "Instance syncing";
    SettingRow {
        label: "Automatic syncing";
        detail: "Selected instances sync every minute while the launcher is open. Games running in this launcher and busy instances are skipped.";
        Toggle { label: "Automatic instance syncing"; checked: InstanceSync.enabled; enabled: InstanceSync.loaded && !InstanceSync.busy; toggled(value) => { InstanceSync.enable-changed(value); } }
    }
    if InstanceSync.enabled: VerticalLayout {
        spacing: Theme.space-3;
        Label { text: "Choose at least two instances"; }
        if InstanceSync.instances.length == 0: Label { text: "Create an instance first, then choose it here."; wrap: word-wrap; }
        ListView {
            height: min(200px, InstanceSync.instances.length * 40px);
            for item[index] in InstanceSync.instances: Rectangle {
                height: 40px;
                Checkbox { width: parent.width; text: item.name; checked: item.checked; enabled: !InstanceSync.busy; toggled(value) => { InstanceSync.participant-changed(index,value); } }
            }
        }
        Label { text: "What to sync"; }
        for item[index] in InstanceSync.categories: Checkbox { text: item.name; checked: item.checked; enabled: !InstanceSync.busy; toggled(value) => { InstanceSync.category-changed(index,value); } }
        Label { text: "Settings and controls follow new edits between matching game and loader versions. Existing differences and conflicting edits are kept. Other content adds missing files. Pack order, worlds and server lists stay local. Close games left running by another launcher session before syncing."; wrap: word-wrap; }
        if InstanceSync.configuration-selected: VerticalLayout {
            spacing: Theme.space-3;
            Label { text: "Choose config/... files or directories (separated by semicolons)"; wrap: word-wrap; }
            TextField { label: "Selected configuration paths"; text <=> InstanceSync.selected-paths; placeholder: "config/sodium-options.json; config/chosen-mod"; max-length: 4096; enabled: !InstanceSync.busy; accepted => { InstanceSync.paths-changed(); } }
        }
        Label { text: "Exclude paths (optional, separated by semicolons; press Enter to save)"; wrap: word-wrap; }
        TextField { label: "Excluded relative paths"; text <=> InstanceSync.exclusions; placeholder: "resourcepacks/private; resourcepacks/local.zip"; max-length: 4096; enabled: !InstanceSync.busy; accepted => { InstanceSync.paths-changed(); } }
    }
    if InstanceSync.message != "": Label { text: InstanceSync.message; wrap: word-wrap; }
}
