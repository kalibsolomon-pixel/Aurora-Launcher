// Home: select an instance and launch it. Nothing else competes here.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";
import { Button, ButtonKind, Dropdown, Glyph, StatusPill, Tone, ProgressBar, EmptyState, FocusRing, KeyboardFocus, Spinner, PageTitle, InstanceIcon } from "../components.slint";
import { Home, Nav, Page, InstanceRow, BlockerRow } from "../state.slint";
import { WidgetGrid, Widgets, MediaGlyphs } from "../widgets.slint";

/// One selectable instance tile.
export component InstanceTile inherits Rectangle {
    in property <InstanceRow> item;
    callback activated();
    height: 64px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    border-width: 0px;
    border-color: Theme.accent-outline;
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-description: root.item.subtitle + ". " + root.item.status;
    accessible-item-selected: root.item.selected;
    accessible-action-default => { activated(); }
    forward-focus: focus;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Glyph { y: (parent.height - self.height) / 2; letter: root.item.letter; size: 40px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.item.name; font-size: Theme.text-body; font-weight: 600; color: root.item.selected ? Theme.accent : Theme.text-secondary; overflow: elide; }

        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.pointer-focus(); root.activated(); } }
    focus := KeyboardFocus {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { root.activated(); return accept; }
            reject
        }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: focus.has-focus && focus.focus-visible; }
}

component BlockerLine inherits HorizontalLayout {
    in property <BlockerRow> item;
    spacing: Theme.space-3;
    padding-top: 6px;
    padding-bottom: 6px;
    Icon { y: (parent.height - self.height) / 2; path: Icons.info; size: 18px; color: Theme.warning; }
    Text { horizontal-stretch: 1; text: root.item.message; font-size: Theme.text-secondary-size; color: Theme.text-secondary; wrap: word-wrap; vertical-alignment: center; }
    if root.item.action != "": Button { text: root.item.action; compact: true; clicked => { Home.blocker-action(root.item.code); } }
}

export component HomePage inherits ScrollView {
    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-5;
        alignment: start;

        if Home.instances.length == 0: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            EmptyState {
                icon: Icons.instances;
                title: "No instance yet";
                message: "Create an instance to install Minecraft and Aurora. Each instance keeps its own mods, worlds and settings.";
                HorizontalLayout {
                    alignment: center;
                    Button { text: "Create instance"; icon: Icons.add; kind: ButtonKind.primary; clicked => { Nav.navigate(Page.instances); } }
                }
            }
        }

        if Home.instances.length > 0: Rectangle {
            max-width: 760px;
            horizontal-stretch: 0;
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            accessible-role: groupbox;
            accessible-label: "Selected instance";
            VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-5;
                HorizontalLayout {
                    spacing: Theme.space-4;
                    if Home.has-instance: InstanceIcon { y: (parent.height - self.height) / 2; path: Home.icon; size: 88px; active: true; }
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: Home.has-instance ? Home.name : "Choose an instance"; font-size: Theme.text-page-title; font-weight: 600; color: Theme.text; overflow: elide; }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if Home.checking: Spinner { y: (parent.height - self.height) / 2; size: 16px; }
                            StatusPill { text: Home.status; tone: Home.tone; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Dropdown { model: Home.instance-names; current-index: Home.instance-index; controlled: true; label: "Selected instance"; placeholder: "Choose an instance"; min-width: 220px; selected(index) => { Home.select-index(index); } }
                    }
                }
                for blocker in Home.blockers: BlockerLine { item: blocker; }
                HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: start;
                    Button {
                        text: Home.play-label;
                        icon: Home.running ? "" : Icons.play;
                        kind: ButtonKind.primary;
                        enabled: Home.can-play;
                        loading: Home.busy;
                        min-width: 240px;
                        control-height: 48px;
                        accessible-description-text: Home.status;
                        clicked => { Home.play(); }
                    }
                    Button { text: ""; icon: Icons.refresh; kind: ButtonKind.ghost; control-height: 48px; accessible-description-text: "Check again"; enabled: !Home.busy; clicked => { Home.refresh(); } }
                }
                if Home.progress-text != "": VerticalLayout {
                    spacing: 6px;
                    Text { text: Home.progress-text; font-size: Theme.text-metadata; color: Theme.text-muted; }
                    ProgressBar { progress: Home.progress; label: Home.progress-text; }
                }
                if Home.message != "": Text {
                    text: Home.message;
                    font-size: Theme.text-secondary-size;
                    color: Home.message-tone == Tone.error ? Theme.error : Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
        if Home.instances.length > 0: HorizontalLayout {
            spacing: Theme.space-2;
            Button { text: "Manage instances"; icon: Icons.instances; kind: ButtonKind.ghost; clicked => { Nav.navigate(Page.instances); } }
            Button { text: "Browse content"; icon: Icons.discover; kind: ButtonKind.ghost; clicked => { Nav.navigate(Page.discover); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: Widgets.editing ? "Done" : "Customize"; icon: Widgets.editing ? Icons.check : MediaGlyphs.tune; kind: ButtonKind.ghost; accessible-description-text: "Add, remove or reorder Home widgets"; clicked => { Widgets.editing = !Widgets.editing; } }
        }
        WidgetGrid { }
    }
}
