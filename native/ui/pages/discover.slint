// Discover: browse Modrinth and install into one chosen instance.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";
import { Button, ButtonKind, Tabs, TextField, Dropdown, EmptyState, Spinner, PageTitle, Glyph } from "../components.slint";
import { Discover, ProjectRow } from "../state.slint";

component ProjectLine inherits Rectangle {
    in property <ProjectRow> item;
    height: max(92px, layout.preferred-height);
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: list-item;
    accessible-label: root.item.title;
    accessible-description: root.item.description;
    touch := TouchArea { }
    layout := HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Glyph { y: (parent.height - self.height) / 2; letter: root.item.letter; picture: root.item.picture; has-picture: root.item.has-picture; size: 48px; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: root.item.title; font-size: Theme.text-body; font-weight: 600; color: Theme.text; overflow: elide; horizontal-stretch: 0; }
            }
            Text { text: root.item.description; font-size: Theme.text-metadata; color: Theme.text-secondary; wrap: word-wrap; max-height: 36px; overflow: elide; }
            Text { text: root.item.author + " · " + root.item.downloads; font-size: Theme.text-label; color: Theme.text-muted; overflow: elide; }
        }
        Button { y: (parent.height - self.height) / 2; text: "Details"; compact: true; enabled: !Discover.install-busy; clicked => { Discover.details(root.item.id); } }
        Button {
            y: (parent.height - self.height) / 2;
            text: root.item.installed ? "Installed" : Discover.kind == 3 ? "Review" : "Install";
            icon: root.item.installed ? Icons.check : Icons.download;
            enabled: !root.item.installed && !Discover.install-busy;
            loading: root.item.busy;
            accessible-description-text: root.item.title;
            clicked => { Discover.install(root.item.id); }
        }
    }
}

export component DiscoverPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;
        HorizontalLayout {
            spacing: Theme.space-3;
            PageTitle { text: "Discover"; horizontal-stretch: 1; vertical-alignment: center; }
            if Discover.has-instances: Text { text: "Install into"; color: Theme.text-muted; font-size: Theme.text-secondary-size; vertical-alignment: center; }
            if Discover.has-instances: Dropdown {
                width: 240px;
                label: "Target instance";
                model: Discover.instance-names;
                current-index <=> Discover.instance-index;
                selected(index) => { Discover.instance-changed(index); }
            }
        }
        if Discover.can-return: HorizontalLayout { alignment: start; Button { text: "Back to instance"; kind: ButtonKind.ghost; clicked => { Discover.return-to-instance(); } } }
        Tabs {
            model: ["Mods", "Resource packs", "Shaders", "Modpacks"];
            current <=> Discover.kind;
            selected(index) => { Discover.kind-changed(index); }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            TextField {
                horizontal-stretch: 1;
                leading-icon: Icons.search;
                placeholder: "Search Modrinth";
                label: "Search Modrinth";
                text <=> Discover.query;
                max-length: 160;
                accepted => { Discover.search(); }
            }
            Button { text: "Search"; kind: ButtonKind.primary; enabled: !Discover.loading && (Discover.has-instances || Discover.kind == 3); clicked => { Discover.search(); } }
        }
        HorizontalLayout {
            spacing: Theme.space-2; alignment: start;
            Dropdown { width: 230px; model: Discover.category-names; label: "Modrinth category"; current-index <=> Discover.category-index; selected => { Discover.filters-changed(); } }
            Dropdown { width: 200px; model: ["Relevance", "Downloads", "Most followed", "Newest", "Recently updated"]; label: "Sort results"; current-index <=> Discover.sort-index; selected => { Discover.filters-changed(); } }
        }
        if Discover.kind == 3: HorizontalLayout {
            alignment: start;
            Dropdown { width: 200px; model: ["All mod loaders", "Fabric", "Forge", "NeoForge"]; label: "Modpack loader"; current-index <=> Discover.loader-index; selected => { Discover.filters-changed(); } }
        }
        if !Discover.has-instances && Discover.kind != 3: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            EmptyState { icon: Icons.discover; title: "Create an instance first"; message: "Content is always installed into one instance, checked for compatibility with its Minecraft version and loader."; }
        }
        if Discover.summary != "": Text { text: Discover.summary; color: Theme.text-muted; font-size: Theme.text-metadata; }
        if Discover.error != "": Text { text: Discover.error; color: Theme.error; wrap: word-wrap; }
        if Discover.error != "": HorizontalLayout { alignment: start; Button { text: "Try again"; enabled: !Discover.loading; clicked => { Discover.search(); } } }
        if Discover.progress != "": Text { text: Discover.progress; color: Theme.text-secondary; wrap: word-wrap; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 4px;
                spacing: 8px;
                alignment: start;
                accessible-role: list;
                accessible-label: "Results";
                for row in Discover.results: ProjectLine { item: row; }
            }
        }
        if Discover.loading: HorizontalLayout { alignment: center; padding: Theme.space-5; Spinner { size: 22px; } }
        if Discover.has-more && !Discover.loading: HorizontalLayout { alignment: center; Button { text: "Show more"; clicked => { Discover.more(); } } }
    }
}
