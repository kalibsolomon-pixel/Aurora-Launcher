// Stable fitting room with an independently scrolling library.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Button, ButtonKind, IconButton, EmptyState, Spinner, PageTitle, FocusRing, KeyboardFocus, Checkbox, Dropdown, Tabs, TextField } from "../components.slint";
import { Skins, SkinRow, CapeRow, Accounts } from "../state.slint";

component PresetLine inherits Rectangle {
    in property <SkinRow> item;
    private property <bool> renaming: false;
    private property <string> draft;
    height: 80px; border-radius: Theme.radius-md;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: list-item;
    accessible-label: "Preview " + item.name;
    accessible-description: item.model;
    accessible-item-selected: item.previewed;
    accessible-action-default => { Skins.preview-skin(root.item.id); }
    forward-focus: focus;
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.pointer-focus(); Skins.preview-skin(root.item.id); } }
    HorizontalLayout {
        padding: 12px; spacing: 8px;
        Button {
            y: (parent.height - self.height) / 2;
            icon: root.item.favorite ? Icons.star-filled : Icons.star;
            accessible-description-text: (root.item.favorite ? "Unfavorite " : "Favorite ") + root.item.name;
            compact: true; kind: ButtonKind.ghost; selected: root.item.favorite;
            enabled: !Skins.busy;
            clicked => { Skins.set-favorite(root.item.id, !root.item.favorite); }
        }
        Rectangle {
            width: 44px; height: 44px; y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm; background: Theme.raised; clip: true;
            if root.item.has-thumb: Image { width: parent.width; height: parent.height; source: root.item.thumb; image-rendering: pixelated; }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 4px;
            if !root.renaming: Text { text: root.item.name; color: root.item.previewed ? Theme.accent : Theme.text; font-size: Theme.text-body; font-weight: 600; overflow: elide; }
            Text { text: root.item.model; color: Theme.text-muted; font-size: Theme.text-metadata; }
        }
        if root.renaming: TextField { y: (parent.height - self.height) / 2; width: 200px; label: "Skin name"; text <=> root.draft; max-length: 80; accepted => { Skins.rename(root.item.id, root.draft); root.renaming = false; } escaped => { root.renaming = false; } }
        IconButton { y: (parent.height - self.height) / 2; icon: root.renaming ? Icons.check : Icons.edit; label: root.renaming ? "Save skin name" : "Rename skin"; enabled: !Skins.busy; clicked => { if root.renaming { Skins.rename(root.item.id, root.draft); root.renaming = false; } else { root.draft = root.item.edit-name; root.renaming = true; } } }
        Button { y: (parent.height - self.height) / 2; text: "Apply"; compact: true; enabled: !Skins.busy && Skins.has-account; accessible-description-text: root.item.name; clicked => { Skins.apply(root.item.id); } }
        IconButton { y: (parent.height - self.height) / 2; icon: Icons.delete; label: "Remove " + root.item.name + " from the library"; enabled: !Skins.busy; clicked => { Skins.remove(root.item.id); } }
    }
    focus := KeyboardFocus { key-pressed(event) => { if (event.text == " " || event.text == Key.Return) { Skins.preview-skin(root.item.id); return accept; } reject } }
    FocusRing { x: 2px; y: 2px; width: root.width - 4px; height: root.height - 4px; shown: focus.has-focus && focus.focus-visible; }
}
component CapeTile inherits Rectangle {
    in property <CapeRow> item;
    height: 192px; border-radius: Theme.radius-md;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: list-item;
    accessible-label: "Preview " + item.name;
    accessible-item-selected: item.previewed;
    accessible-action-default => { Skins.preview-cape(root.item.id); }
    forward-focus: focus;
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.pointer-focus(); Skins.preview-cape(root.item.id); } }
    VerticalLayout {
        padding: 12px; spacing: 8px; alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle { width: 60px; height: 96px;
                if root.item.has-picture: Image { width: parent.width; height: parent.height; source: root.item.picture; image-rendering: pixelated; image-fit: contain; }
            }
        }
        Text { text: root.item.name; horizontal-alignment: center; color: root.item.previewed ? Theme.accent : Theme.text; font-size: Theme.text-body; font-weight: 600; overflow: elide; }
        HorizontalLayout {
            alignment: center;
            if root.item.selected: Text { height: 30px; text: "Wearing"; color: Theme.accent; font-size: Theme.text-metadata; vertical-alignment: center; }
            if !root.item.selected: Button { text: "Wear"; compact: true; enabled: !Skins.busy; accessible-description-text: root.item.name; clicked => { Skins.select-cape(root.item.id); } }
        }
    }
    focus := KeyboardFocus { key-pressed(event) => { if (event.text == " " || event.text == Key.Return) { Skins.preview-cape(root.item.id); return accept; } reject } }
    FocusRing { x: 2px; y: 2px; width: root.width - 4px; height: root.height - 4px; shown: focus.has-focus && focus.focus-visible; }
}
component CapeGallery inherits Rectangle {
    private property <int> columns: max(1, floor((self.width + 12px) / 160px));
    private property <length> tile-width: (self.width - (columns - 1) * 12px) / columns;
    height: floor((Skins.capes.length + columns - 1) / columns) * 204px;
    accessible-role: list;
    accessible-label: "Owned capes";
    for row[i] in Skins.capes: CapeTile {
        item: row;
        x: mod(i, root.columns) * (root.tile-width + 12px);
        y: floor(i / root.columns) * 204px;
        width: root.tile-width;
    }
}
export component PlayerViewer inherits Rectangle {
    private property <length> last-x;
    private property <length> last-y;
    background: Theme.sunken; border-radius: Theme.radius-lg; clip: true;
    accessible-role: image;
    accessible-label: "3D player preview. Drag to rotate, scroll to zoom. Arrow keys rotate; Home resets.";
    forward-focus: focus;
    Image { source: Skins.player; width: parent.width; height: parent.height; image-fit: contain; image-rendering: pixelated; }
    drag := TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(event) => { if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { focus.pointer-focus(); root.last-x=self.mouse-x; root.last-y=self.mouse-y; } }
        moved => { if (self.pressed) { Skins.rotate((self.mouse-x - root.last-x)/1px, (self.mouse-y - root.last-y)/1px); root.last-x=self.mouse-x; root.last-y=self.mouse-y; } }
        scroll-event(event) => { Skins.zoom(event.delta-y / 120px); accept }
    }
    focus := KeyboardFocus {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { Skins.rotate(-25,0); return accept; }
            if (event.text == Key.RightArrow) { Skins.rotate(25,0); return accept; }
            if (event.text == Key.UpArrow) { Skins.rotate(0,15); return accept; }
            if (event.text == Key.DownArrow) { Skins.rotate(0,-15); return accept; }
            if (event.text == Key.Home) { Skins.reset-view(); return accept; }
            reject
        }
    }
    FocusRing { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; shown: focus.has-focus && focus.focus-visible; }
}
export component SkinsPage inherits Rectangle {
    private property <int> library-tab: 0;
    VerticalLayout {
        padding: root.width < 760px ? Theme.space-5 : Theme.space-6;
        spacing: Theme.space-5;
        HorizontalLayout {
            PageTitle { text: "Skins & Capes"; horizontal-stretch: 1; vertical-alignment: center; }
            IconButton { icon: Icons.refresh; label: "Reload skins and capes"; size: 36px; enabled: !Skins.loading; clicked => { Skins.refresh(); } }
        }
        HorizontalLayout {
            spacing: Theme.space-5;
            VerticalLayout {
                width: min(320px, max(220px, root.width * 0.33));
                spacing: 10px; alignment: start;
                Text { text: Skins.has-account ? Skins.account-name : "Your appearance"; color: Theme.text; font-size: Theme.text-identity; font-weight: 600; overflow: elide; }
                Text { text: Skins.preview-label; color: Theme.text-secondary; font-size: Theme.text-metadata; overflow: elide; }
                PlayerViewer { height: min(440px, max(200px, root.height - 300px)); }
                HorizontalLayout {
                    spacing: 4px;
                    Button { text: "Front"; compact: true; kind: ButtonKind.ghost; selected: !Skins.rear-view; clicked => { Skins.view-back(false); } }
                    Button { text: "Back"; compact: true; kind: ButtonKind.ghost; selected: Skins.rear-view; clicked => { Skins.view-back(true); } }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: Icons.refresh; label: "Reset view"; clicked => { Skins.reset-view(); } }
                }
                HorizontalLayout { Checkbox { text: "Outer layers"; checked <=> Skins.outer-layers; toggled => { Skins.layers-changed(); } } }
                Text { text: "Drag to rotate · Scroll to zoom"; color: Theme.text-muted; font-size: Theme.text-label; }
                Text { text: Skins.cape-label; color: Theme.text-secondary; font-size: Theme.text-metadata; overflow: elide; }
            }
            VerticalLayout {
                horizontal-stretch: 1; spacing: Theme.space-3;
                Tabs { model: ["Skins", "Capes"]; current <=> root.library-tab; }
                if root.library-tab == 0: HorizontalLayout {
                    alignment: start; spacing: 8px;
                    Dropdown { label: "Imported skin model"; model: ["Classic", "Slim"]; current-index <=> Skins.import-model; enabled: !Skins.busy; width: 130px; }
                    Button { text: "Import PNG"; icon: Icons.add; enabled: !Skins.busy; clicked => { Skins.import-file(); } }
                }
                if root.library-tab == 0: HorizontalLayout {
                    alignment: start; spacing: 8px;
                    Button { text: "Current skin"; compact: true; kind: ButtonKind.ghost; enabled: Skins.has-current; clicked => { Skins.preview-current(); } }
                    if Skins.has-current: Button { text: "Save to library"; compact: true; kind: ButtonKind.ghost; enabled: !Skins.busy; clicked => { Skins.save-current(); } }
                }
                if root.library-tab == 0: Checkbox { text: "Favorites only"; checked <=> Skins.favorites-only; toggled(value) => { Skins.filter-favorites(value); } }
                Text { text: root.library-tab == 0 ? "Select a skin to preview" : "Select a cape to view its outward face"; color: Theme.text-muted; font-size: Theme.text-metadata; wrap: word-wrap; }
                ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout {
                        padding: 4px; spacing: 6px; alignment: start;
                        if root.library-tab == 0 && Skins.presets.length == 0: EmptyState { icon: Icons.image; title: Skins.favorites-only ? "No favorites yet" : "Your skin library"; message: Skins.favorites-only ? "Turn off Favorites only to see all saved skins." : "Import a PNG or save your current skin to get started."; }
                        if root.library-tab == 0: VerticalLayout { spacing: 6px; accessible-role: list; accessible-label: "Saved skins"; for row in Skins.presets: PresetLine { item: row; } }
                        if root.library-tab == 1 && !Skins.has-account: EmptyState {
                            icon: Icons.person; title: "Your cape collection"; message: "Sign in to see the capes owned by your Minecraft account.";
                            HorizontalLayout { alignment: center; Button { text: "Sign in"; kind: ButtonKind.primary; clicked => { Accounts.open-dialog(); } } }
                        }
                        if root.library-tab == 1 && Skins.has-account && Skins.capes.length == 0 && !Skins.loading: EmptyState { icon: Icons.image; title: "No capes yet"; message: "Capes owned by this account will appear here."; }
                        if root.library-tab == 1 && Skins.has-account && Skins.capes.length > 0: CapeGallery { }
                    }
                }
                if root.library-tab == 1 && Skins.capes.length > 0: HorizontalLayout {
                    alignment: start; spacing: 8px;
                    Button { text: "Preview no cape"; compact: true; kind: ButtonKind.ghost; clicked => { Skins.preview-cape(""); } }
                    Button { text: "Wear no cape"; compact: true; kind: ButtonKind.ghost; enabled: !Skins.busy; clicked => { Skins.disable-cape(); } }
                }
                if !Skins.has-account && root.library-tab == 0: HorizontalLayout { alignment: start; Button { text: "Sign in to apply skins"; compact: true; clicked => { Accounts.open-dialog(); } } }
                if Skins.loading || Skins.busy: HorizontalLayout { alignment: start; spacing: 8px; Spinner { size: 16px; } Text { text: Skins.busy ? "Updating appearance…" : "Loading appearance…"; color: Theme.text-secondary; font-size: Theme.text-metadata; } }
                if Skins.error != "": Text { text: Skins.error; color: Theme.error; wrap: word-wrap; }
                Text { text: "Previews stay local. Apply or Wear updates your account."; color: Theme.text-muted; font-size: Theme.text-label; wrap: word-wrap; }
            }
        }
    }
}
