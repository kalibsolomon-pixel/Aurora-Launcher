import { Recovery } from "../state.slint";
// Instances manages installations; each workspace manages one instance's
// configuration and content.
import { InstanceSyncSettings } from "../syncing.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";
import {
    Button, ButtonKind, IconButton, ContentArtwork, ContentList, ContentRowBackground, StatusPill, Tone, Toggle, Slider, TextField, Tabs,
    Group, SettingRow, Divider, EmptyState, Spinner, PageTitle, FocusRing, KeyboardFocus,
    InstanceIcon, Dropdown, ProgressBar, UnifiedList,
} from "../components.slint";
import { Home, Instances, ContentRow, InstanceRow, BlockerRow } from "../state.slint";

/// One near-square instance card: a large identity icon, the name, the
/// Minecraft version. The Home selection is shown by the
/// accent icon and name, never by a thick border.
component InstanceCard inherits Rectangle {
    in property <InstanceRow> item;
    callback activated();
    border-radius: Theme.radius-lg;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-description: root.item.subtitle + (root.item.selected ? ". Selected on Home" : "");
    accessible-item-selected: root.item.selected;
    accessible-action-default => { activated(); }
    forward-focus: focus;
    VerticalLayout {
        padding: 14px;
        padding-top: 18px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout { alignment: center; InstanceIcon { path: root.item.icon; size: min(76px, root.width * 0.42); active: root.item.selected; } }
        Rectangle { height: 6px; }
        Text { text: root.item.name; font-size: Theme.text-body; font-weight: 600; color: root.item.selected ? Theme.accent : Theme.text; horizontal-alignment: center; overflow: elide; }
        Text { text: root.item.subtitle; font-size: Theme.text-metadata; color: Theme.text-muted; horizontal-alignment: center; overflow: elide; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.pointer-focus(); root.activated(); } }
    focus := KeyboardFocus {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) { root.activated(); return accept; }
            reject
        }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; shown: focus.has-focus && focus.focus-visible; }
}

export component InstancesPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;
        HorizontalLayout {
            spacing: Theme.space-4;
            PageTitle { text: "Instances"; horizontal-stretch: 1; vertical-alignment: center; }
            Button { text: "Import modpack"; icon: Icons.download; loading: Instances.pack-import-busy; clicked => { Instances.import-modpack(); } }
            Button { text: "New instance"; icon: Icons.add; kind: ButtonKind.primary; clicked => { Instances.create(); } }
        }
        if Instances.loading: HorizontalLayout { alignment: center; padding: Theme.space-6; Spinner { size: 24px; } }
        if !Instances.loading && Instances.rows.length == 0: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            EmptyState {
                icon: Icons.instances;
                title: "No instances";
                message: "An instance is an isolated Minecraft installation with its own mods, worlds and settings. Your normal .minecraft folder is never used.";
            }
        }
        grid := ScrollView {
            vertical-stretch: 1;
            // A responsive grid of near-square cards, 168–220 px wide.
            property <length> gap: 14px;
            property <int> columns: max(1, floor((self.visible-width - 8px + gap) / (168px + gap)));
            property <length> card-width: min(220px, (self.visible-width - 8px - (columns - 1) * gap) / columns);
            // Keep the identity stack compact at every responsive width.
            property <length> card-height: max(180px, card-width);
            Rectangle {
                x: 0;
                y: 0;
                width: grid.visible-width;
                height: ceil(Instances.rows.length / grid.columns) * (grid.card-height + grid.gap) + 8px;
                accessible-role: list;
                accessible-label: "Instances";
                for row[i] in Instances.rows: InstanceCard {
                    x: 4px + mod(i, grid.columns) * (grid.card-width + grid.gap);
                    y: 4px + floor(i / grid.columns) * (grid.card-height + grid.gap);
                    width: grid.card-width;
                    height: grid.card-height;
                    item: row;
                    activated => { Instances.open(row.id); }
                }
            }
        }
    }
}

component ContentLine inherits Rectangle {
    in property <ContentRow> item;
    // Follows the scroll position. Rendering reads only the copy below, which
    // changes when a row crosses the margin, so scrolling keeps the list's
    // cached layer instead of repainting every row on every frame.
    in property <bool> near-view: false;
    private property <bool> artwork-visible: false;
    changed near-view => { root.show-artwork(); }
    init => { root.show-artwork(); }
    function show-artwork() {
        root.artwork-visible = root.near-view;
        Instances.content-icon-visible(Instances.id, root.item.id, root.near-view);
    }
    in property <bool> show-separator: false;
    in property <bool> first-row: false;
    in property <bool> last-row: false;
    height: max(56px, layout.preferred-height);
    background: transparent;
    accessible-role: list-item;
    accessible-label: root.item.title;
    accessible-description: root.item.detail + (root.item.update-text != "" ? ". " + root.item.update-text : "");
    ContentRowBackground { width: parent.width; height: parent.height; first-row: root.first-row; last-row: root.last-row; hovered: touch.has-hover; }
    touch := TouchArea { }
    layout := HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;
        Rectangle {
            width: 48px; height: 48px;
            if root.artwork-visible: ContentArtwork { letter: root.item.letter; picture: root.item.picture; has-picture: root.item.has-picture; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text { text: root.item.title; font-size: Theme.text-body; color: root.item.enabled ? Theme.text : Theme.text-muted; overflow: elide; }
            Text { text: root.item.detail; font-size: Theme.text-secondary-size; color: Theme.text-secondary; overflow: elide; }

        }
        if root.item.note != "": IconButton {
            size: 36px;
            icon: Icons.warning; label: root.item.note; tooltip-above: true;
        }
        if root.item.update-text != "": StatusPill {
            y: (parent.height - self.height) / 2;
            text: root.item.update-text;
            tone: root.item.update-tone;
        }
        if root.item.can-update: Button {
            y: (parent.height - self.height) / 2;
            text: "Update";
            icon: Icons.download;
            enabled: !Instances.installing;
            clicked => { Instances.content-update(root.item.id); }
        }
        if root.item.can-unpin: Button {
            y: (parent.height - self.height) / 2;
            text: "Unpin";
            kind: ButtonKind.ghost;
            clicked => { Instances.content-unpin(root.item.id); }
        }
        if root.item.is-mod || root.item.toggleable: Rectangle {
            width: 40px; height: 36px;
            Toggle {
                y: (parent.height - self.height) / 2;
                enabled: root.item.toggleable && !Instances.installing;
                checked: root.item.enabled;
                label: (root.item.enabled ? "Disable " : "Enable ") + root.item.title;
                toggled(value) => { Instances.content-toggle(root.item.id, value); }
            }
        }
        if root.item.is-mod || root.item.removable: IconButton {
            size: 36px;
            enabled: root.item.removable && !Instances.installing;
            y: (parent.height - self.height) / 2;
            icon: Icons.delete;
            label: "Remove " + root.item.title;
            clicked => { Instances.content-remove(root.item.id, root.item.title); }
        }
    }
    if root.show-separator: Divider { x: 16px; y: parent.height - self.height; width: parent.width - 32px; }
}

component LaunchBlockerLine inherits HorizontalLayout {
    in property <BlockerRow> item;
    spacing: Theme.space-3;
    padding-top: 6px;
    padding-bottom: 6px;
    Icon { y: (parent.height - self.height) / 2; path: Icons.info; size: 18px; color: Theme.warning; }
    Text { horizontal-stretch: 1; text: root.item.message; font-size: Theme.text-secondary-size; color: Theme.text-secondary; wrap: word-wrap; vertical-alignment: center; }
    if root.item.action != "": Button { text: root.item.action; compact: true; enabled: !Instances.config-dirty; clicked => { Home.blocker-action(root.item.code); } }
}

component ConfigurationTab inherits VerticalLayout {
    spacing: Theme.space-4;
    Group {
        title: "Game";

        SettingRow {
            label: "Minecraft version";
            detail: "Changing this requires installing new game files.";
            Dropdown {
                width: 220px;
                label: "Minecraft version";
                model: Instances.cfg-versions;
                current-index <=> Instances.cfg-version-index;
                enabled: Instances.cfg-versions.length > 0 && !Instances.config-busy && !Instances.installing;
                placeholder: "Loading…";
                selected => { Instances.cfg-platform-changed(); }
            }
        }
        SettingRow {
            label: "Mod loader";
            detail: Instances.cfg-loader-kind-note;
            Dropdown {
                width: 220px;
                label: "Mod loader";
                model: Instances.cfg-loaders;
                current-index <=> Instances.cfg-loader-index;
                enabled: Instances.cfg-loader-kind-enabled && !Instances.config-busy && !Instances.installing;
                selected => { Instances.cfg-platform-changed(); }
            }
        }
        if Instances.cfg-has-loader: SettingRow {
            label: Instances.cfg-loader-label;
            detail: Instances.cfg-loader-note;
            Dropdown {
                min-width: 220px;
                max-width: 380px;
                horizontal-stretch: 1;
                label: Instances.cfg-loader-label;
                model: Instances.cfg-loader-versions;
                current-index <=> Instances.cfg-loader-version-index;
                enabled: !Instances.cfg-loader-loading && !Instances.config-busy && !Instances.installing;
                placeholder: "Loading…";
                selected => { Instances.config-edited(); }
            }
        }
    }
    Group {
        title: "Java";
        description: "Aurora's managed Java is recommended. A custom Java is checked by running it, and is checked again before every launch.";
        SettingRow {
            label: "Runtime";
            detail: Instances.cfg-java-index == 0 ? "Managed by Aurora: the exact version this game requires, verified and installed automatically." : "Your own Java installation, used to launch this instance only.";
            Dropdown {
                min-width: 220px;
                max-width: 380px;
                horizontal-stretch: 1;
                label: "Java runtime";
                model: ["Managed by Aurora (recommended)", "Custom Java executable"];
                current-index <=> Instances.cfg-java-index;
                enabled: !Instances.config-busy;
                selected => { Instances.cfg-java-changed(); }
            }
        }
        if Instances.cfg-java-index == 1: VerticalLayout {
            spacing: 8px;
            Text { text: "Java executable"; color: Theme.text; font-size: Theme.text-body; }
            Text { text: "Choose java.exe or javaw.exe from an installation you trust. Check runs that executable for the saved game version."; color: Theme.text-muted; font-size: Theme.text-metadata; wrap: word-wrap; }
                TextField {
                    horizontal-stretch: 1;
                    height: Theme.control-height;
                    max-length: 4096;
                    label: "Custom Java executable path";
                    placeholder: "C:\\Program Files\\Java\\…\\bin\\javaw.exe";
                    text <=> Instances.cfg-java-path;
                    enabled: !Instances.config-busy;
                    edited => { Instances.cfg-java-changed(); }
                }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { text: "Choose…"; icon: Icons.folder; enabled: !Instances.config-busy && !Instances.cfg-java-busy; clicked => { Instances.cfg-java-choose(); } }
                Button { text: "Check"; icon: Icons.refresh; loading: Instances.cfg-java-busy; enabled: Instances.cfg-java-path != "" && !Instances.config-busy; clicked => { Instances.cfg-java-check(); } }
                Button { text: "Use managed Java"; kind: ButtonKind.ghost; enabled: !Instances.config-busy; clicked => { Instances.cfg-java-index = 0; Instances.cfg-java-changed(); } }
            }
            Text {
                text: Instances.cfg-java-status != "" ? Instances.cfg-java-status : "Not checked yet. Save applies the selection; Play checks it again.";
                color: Instances.cfg-java-tone == Tone.error ? Theme.error : Instances.cfg-java-tone == Tone.success ? Theme.success : Theme.text-muted;
                font-size: Theme.text-metadata;
                wrap: word-wrap;
            }
        }
    }
    Group {
        title: "Memory";
        description: Instances.memory-hint;
        SettingRow {
            label: "Maximum memory";
            detail: "MiB (512–32768)";
            HorizontalLayout {
                spacing: Theme.space-1;
                TextField {
                    width: 132px;
                    height: 56px;
                    label: "Maximum memory in MiB";
                    text <=> Instances.memory-mib-text;
                    max-length: 5;
                    enabled: !Instances.config-busy && !Instances.installing;
                    edited => { Instances.config-edited(); }
                    accepted => { Instances.config-edited(); }
                }
                VerticalLayout {
                    spacing: 0px;
                    IconButton {
                        size: 28px;
                        show-tooltip: false;
                        icon: "M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z";
                        label: "Increase maximum memory by 1 GiB";
                        enabled: !Instances.config-busy && !Instances.installing;
                        clicked => { Instances.memory-step(1); }
                    }
                    IconButton {
                        size: 28px;
                        show-tooltip: false;
                        icon: Icons.expand;
                        label: "Decrease maximum memory by 1 GiB";
                        enabled: !Instances.config-busy && !Instances.installing;
                        clicked => { Instances.memory-step(-1); }
                    }
                }
            }
        }
        SettingRow {
            label: "Java arguments";
            detail: "Optional";
            TextField {
                width: 320px;
                label: "Additional Java arguments";
                placeholder: "None";
                text <=> Instances.jvm-args;
                edited => { Instances.config-edited(); }
            }
        }
    }
    Group {
        title: "Window";
        SettingRow {
            label: "Custom game window size";
            detail: "Otherwise Minecraft chooses its default size.";
            Toggle { label: "Custom game window size"; checked <=> Instances.custom-window; toggled => { Instances.config-edited(); } }
        }
        if Instances.custom-window: SettingRow {
            label: "Width × height";
            detail: "100 – 7680 pixels.";
            HorizontalLayout {
                spacing: 8px;
                TextField { width: 96px; label: "Window width"; text <=> Instances.window-width; edited => { Instances.config-edited(); } }
                Text { text: "×"; color: Theme.text-muted; vertical-alignment: center; }
                TextField { width: 96px; label: "Window height"; text <=> Instances.window-height; edited => { Instances.config-edited(); } }
            }
        }
    }
    if Instances.config-error != "": Text { text: Instances.config-error; color: Theme.error; font-size: Theme.text-secondary-size; wrap: word-wrap; }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.space-2;
        Button { text: "Revert"; kind: ButtonKind.ghost; enabled: Instances.config-dirty && !Instances.config-busy; clicked => { Instances.revert-config(); } }
        Button { text: "Save"; kind: ButtonKind.primary; enabled: Instances.config-dirty; loading: Instances.config-busy; clicked => { Instances.save-config(); } }
    }
    Group {
        title: "Aurora Client";
        SettingRow {
            label: Instances.client-installed ? "Installed" : "Add to this instance";
            detail: Instances.client-note;
            Button {
                text: Instances.client-installed ? "Remove Aurora Client" : "Add Aurora Client";
                loading: Instances.client-busy;
                enabled: (Instances.client-installed || Instances.client-available) && !Instances.client-busy && !Instances.config-busy && !Instances.config-dirty && !Instances.installing && !Instances.cfg-needs-install;
                clicked => { Instances.client-review(); }
            }
        }
    }
    Group {
        title: "Identity";
        HorizontalLayout {
            spacing: Theme.space-3;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            InstanceIcon { y: (parent.height - self.height) / 2; path: Instances.icon; size: 64px; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.space-1;
                Text { text: Instances.name; font-size: Theme.text-identity; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                Text { text: Instances.icon-label; font-size: Theme.text-metadata; color: Theme.text-muted; wrap: word-wrap; }
            }
            Button { y: (parent.height - self.height) / 2; text: "Edit"; icon: Icons.edit; compact: true; kind: ButtonKind.ghost; accessible-description-text: "Edit instance name and icon"; clicked => { Instances.rename-start(); } }
        }
    }
    Group {
        title: "Installation";
        SettingRow {
            label: "Health";
            detail: Instances.health-text;
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Check"; icon: Icons.refresh; loading: Instances.health-busy; clicked => { Instances.validate(); } }
                Button { text: "Smart recovery"; enabled: !Recovery.busy && !Instances.installing && !Instances.config-dirty; clicked => { Recovery.inspect(); } }
                if Instances.can-repair: Button { text: "Repair"; kind: ButtonKind.primary; enabled: !Instances.health-busy; clicked => { Instances.repair(); } }
            }
        }
        if Instances.cfg-needs-install: SettingRow {
            label: "Saved settings not installed";
            detail: "The saved Minecraft version or loader differs from the installed game. Install them to apply.";
            Button { text: "Install now"; kind: ButtonKind.primary; loading: Instances.health-busy; enabled: !Instances.config-dirty; clicked => { Instances.install-configuration(); } }
        }
        if Instances.pack-name != "": SettingRow {
            label: "Modpack";
            detail: Instances.pack-update-text != "" ? Instances.pack-name + " · " + Instances.pack-update-text : Instances.pack-name;
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Check for update"; icon: Icons.refresh; loading: Instances.pack-update-busy; enabled: !Instances.installing; clicked => { Instances.pack-check-update(); } }
                if Instances.pack-update-available: Button { text: "Review update"; kind: ButtonKind.primary; enabled: !Instances.pack-update-busy && !Instances.installing; clicked => { Instances.pack-review-update(); } }
            }
        }
        if Instances.runtime-text != "": SettingRow { label: "Java"; detail: Instances.runtime-text; }
        SettingRow {
            label: "Instance folder";
            detail: "Worlds, mods and settings for this instance.";
            Button { text: "Open folder"; icon: Icons.folder; clicked => { Instances.open-folder(); } }
        }
    }
    if Instances.selected: Group {
        title: "Launch details";
        HorizontalLayout {
            alignment: end;
            Button { text: "Refresh readiness"; icon: Icons.refresh; enabled: !Home.busy; clicked => { Home.refresh(); } }
        }
        for blocker in Home.blockers: LaunchBlockerLine { item: blocker; }
        if Home.progress-text != "": VerticalLayout {
            spacing: 6px;
            Text { text: Home.progress-text; font-size: Theme.text-metadata; color: Theme.text-muted; wrap: word-wrap; }
            ProgressBar { progress: Home.progress; label: Home.progress-text; }
        }
        if Home.message != "": Text {
            text: Home.message;
            font-size: Theme.text-secondary-size;
            color: Home.message-tone == Tone.error ? Theme.error : Theme.text-secondary;
            wrap: word-wrap;
        }
    }
    InstanceSyncSettings {}
    Group {
        title: "Delete instance";
        description: "Permanently removes this instance, including its worlds, mods and settings. Shared Java runtimes and downloads are kept.";
        HorizontalLayout {
            alignment: end;
            Button { text: "Delete instance…"; kind: ButtonKind.danger; icon: Icons.delete; enabled: !Instances.config-busy; clicked => { Instances.delete-start(); } }
        }
    }
}

component ContentTab inherits VerticalLayout {
    in property <string> noun;
    in property <length> visible-top;
    in property <length> visible-height;
    spacing: Theme.space-3;
    HorizontalLayout {
        spacing: Theme.space-2;
        TextField {
            horizontal-stretch: 1;
            leading-icon: Icons.search;
            placeholder: "Filter installed " + root.noun;
            label: "Filter installed " + root.noun;
            text <=> Instances.content-filter;
            edited(text) => { Instances.content-filter-changed(text); }
        }
        Button { text: "Find more"; icon: Icons.discover; clicked => { Instances.content-discover(); } }
        Button { text: "Import file"; enabled: !Instances.installing; clicked => { Instances.content-import(); } }
        IconButton { tooltip-above: true; icon: Icons.folder; label: "Open folder"; size: 36px; clicked => { Instances.content-open-folder(); } }
        IconButton { tooltip-above: true; icon: Icons.refresh; label: "Refresh"; accessible-description: "Reload content and check for compatible updates"; size: 36px; enabled: !Instances.content-loading && !Instances.updates-busy && !Instances.installing; clicked => { Instances.content-refresh(); } }
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Instances.updates-summary;
            color: Instances.updates-count > 0 ? Theme.text : Theme.text-muted;
            font-size: Theme.text-secondary-size;
            wrap: word-wrap;
        }
        if Instances.updates-busy: Spinner { size: 18px; }
        if Instances.updates-count > 1: Button {
            text: "Update all (" + Instances.updates-count + ")";
            kind: ButtonKind.primary;
            icon: Icons.download;
            enabled: !Instances.updates-busy && !Instances.installing;
            clicked => { Instances.update-all(); }
        }
    }
    if Instances.content-loading: HorizontalLayout { alignment: center; padding: Theme.space-5; Spinner { size: 22px; } }
    if Instances.content-error != "": Text { text: Instances.content-error; color: Theme.error; wrap: word-wrap; }
    if !Instances.content-loading && Instances.content.length == 0 && Instances.content-error == "": Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        EmptyState { icon: Icons.extension; title: "Nothing installed"; message: "Use Find more to browse Modrinth, or place files in the instance folder."; }
    }
    content-list := ContentList {
        for row[i] in Instances.content: ContentLine {
            item: row;
            near-view: self.y + self.height + content-list.y >= root.visible-top - 64px && self.y + content-list.y <= root.visible-top + root.visible-height + 64px;
            first-row: i == 0;
            last-row: i == Instances.content.length - 1;
            show-separator: i < Instances.content.length - 1;
        }
    }
}

export component WorkspacePage inherits ScrollView {
    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-4;
        alignment: start;
        HorizontalLayout {
            spacing: Theme.space-3;
            IconButton { y: (parent.height - self.height) / 2; icon: Icons.back; label: "Back to instances"; size: 36px; clicked => { Instances.close-workspace(); } }
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 56px;
                height: 56px;
                accessible-role: button;
                accessible-label: "Edit icon and name. Current icon: " + Instances.icon-label;
                accessible-action-default => { Instances.rename-start(); }
                InstanceIcon { path: Instances.icon; size: 56px; active: header-icon-touch.has-hover; }
                header-icon-touch := TouchArea { mouse-cursor: pointer; clicked => { Instances.rename-start(); } }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    PageTitle { text: Instances.name; overflow: elide; horizontal-stretch: 0; }
                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.edit; label: "Edit name and icon"; size: 28px; clicked => { Instances.rename-start(); } }
                }
                Text { text: Instances.subtitle; font-size: Theme.text-secondary-size; color: Theme.text-secondary; overflow: elide; }
            }
            StatusPill { y: (parent.height - self.height) / 2; text: Instances.status; tone: Instances.tone; }
            if !Instances.selected: Button { y: (parent.height - self.height) / 2; text: "Use on Home"; clicked => { Instances.make-selected(); } }
            Button { y: (parent.height - self.height) / 2; text: "Play"; icon: Icons.play; kind: ButtonKind.primary; enabled: !Instances.installing; clicked => { Instances.play(); } }
        }
        Tabs {
            model: ["Mods", "Resource packs", "Shaders", "Settings"];
            current <=> Instances.tab;
            selected(index) => { Instances.tab-changed(index); }
        }
        if Instances.tab == 0: ContentTab { noun: "mods"; visible-top: -root.content-y - self.y; visible-height: root.visible-height; }
        if Instances.tab == 1: ContentTab { noun: "resource packs"; visible-top: -root.content-y - self.y; visible-height: root.visible-height; }
        if Instances.tab == 2: ContentTab { noun: "shaders"; visible-top: -root.content-y - self.y; visible-height: root.visible-height; }
        if Instances.tab == 3: ConfigurationTab { max-width: 1120px; }
    }
}
