// Home widgets: a small fixed grid with add, remove and reorder. Rust builds
// every card from existing launcher records (gameplay history, instance
// state, system media sessions); cards never poll or compute on their own.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Button, ButtonKind, IconButton, Spinner, Dropdown, Tooltip } from "components.slint";

export struct PlaytimePoint { label: string, value: string, detail: string, fraction: float }

export struct WidgetLine {
    label: string,
    value: string,
    detail: string,
}

export struct WidgetView {
    id: string,
    title: string,
    icon: string,
    lines: [WidgetLine],
    empty: string,
    loading: bool,
    column: int, row: int, width: int, height: int,
    requested-width: int, requested-height: int,
}

export struct WidgetChoice {
    id: string,
    title: string,
    icon: string,
}

export global Widgets {
    in property <[WidgetView]> items;
    in property <[WidgetChoice]> available;
    in property <[string]> available-names;
    in-out property <bool> editing: false;
    callback add(string);
    callback remove(string);
    callback move(string, int);
    callback place(string, int);
    callback resize(string, int, int);
    callback columns-changed(int);
    in property <int> grid-rows;
    in property <[string]> names;
    in property <[string]> positions;
    in property <[PlaytimePoint]> week;
    in property <[PlaytimePoint]> month;
    in property <string> week-peak;
    in property <string> month-peak;
    in-out property <int> edit-index: 0;

    // System media session (Windows Global System Media Transport Controls).
    in property <bool> media-supported: false;
    in property <bool> media-active: false;
    in property <string> media-title;
    in property <string> media-artist;
    in property <string> media-source;
    in property <image> media-art;
    in property <bool> media-has-art: false;
    in property <bool> media-playing: false;
    in property <bool> media-can-toggle: false;
    in property <bool> media-can-next: false;
    in property <bool> media-can-previous: false;
    in property <int> media-session-count: 0;
    callback media-toggle();
    callback media-next();
    callback media-previous();
    callback media-cycle();
}

export global MediaGlyphs {
    out property <string> play: "M8 5v14l11-7z";
    out property <string> pause: "M6 19h4V5H6v14zm8-14v14h4V5h-4z";
    out property <string> next: "M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z";
    out property <string> previous: "M6 6h2v12H6zm3.5 6l8.5 6V6z";
    out property <string> music: "M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z";
    out property <string> swap: "M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z";
    out property <string> up: "M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z";
    out property <string> down: "M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z";
    out property <string> tune: "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z";
}

component CardHeader inherits HorizontalLayout {
    in property <WidgetView> item;
    in property <bool> first;
    in property <bool> last;
    spacing: 8px;
    height: 28px;
    Icon { y: (parent.height - self.height) / 2; path: root.item.icon; size: 18px; color: Theme.accent; }
    Text { horizontal-stretch: 1; text: root.item.title; font-size: Theme.text-body; font-weight: 600; color: Theme.text; vertical-alignment: center; overflow: elide; }
    if root.item.loading: Spinner { y: (parent.height - self.height) / 2; size: 14px; }
    if Widgets.editing: IconButton { icon: Icons.close; label: "Remove " + root.item.title; size: 28px; clicked => { Widgets.remove(root.item.id); } }
}

export component WidgetLayoutEditor inherits Rectangle {
    height: layout.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    property <int> selected: min(max(Widgets.edit-index, 0), Widgets.items.length - 1);
    layout := VerticalLayout {
        padding: 14px; spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Text { text: "Arrange widgets"; font-size: Theme.text-body; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            Dropdown { horizontal-stretch: 1; model: Widgets.names; current-index: root.selected; label: "Widget to arrange"; selected(index) => { Widgets.edit-index = index; } }
        }
        if Widgets.items.length > 0: HorizontalLayout {
            spacing: 8px;
            Dropdown { horizontal-stretch: 1; min-width: 100px; model: ["Width: 1", "Width: 2", "Width: 3", "Width: 4", "Width: 5", "Width: 6"]; current-index: Widgets.items[root.selected].requested-width - 1; label: "Widget width in columns"; controlled: true; selected(index) => { Widgets.resize(Widgets.items[root.selected].id, index + 1, Widgets.items[root.selected].requested-height); } }
            Dropdown { horizontal-stretch: 1; min-width: 100px; model: ["Height: 1", "Height: 2", "Height: 3"]; current-index: Widgets.items[root.selected].requested-height - 1; label: "Widget height in rows"; controlled: true; selected(index) => { Widgets.resize(Widgets.items[root.selected].id, Widgets.items[root.selected].requested-width, index + 1); } }
            Dropdown { horizontal-stretch: 1; min-width: 100px; model: Widgets.positions; current-index: root.selected; label: "Widget position"; controlled: true; selected(index) => { Widgets.place(Widgets.items[root.selected].id, index); Widgets.edit-index = index; } }
        }
        if Widgets.available.length > 0: HorizontalLayout {
            spacing: 8px;
            Dropdown { horizontal-stretch: 1; model: Widgets.available-names; label: "Add a widget"; current-index: -1; placeholder: "Add widget"; selected(index) => { Widgets.add(Widgets.available[index].id); } }
        }
    }
}

component PlaytimeCard inherits Rectangle {
    in property <WidgetView> item;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    accessible-role: groupbox;
    accessible-label: "Daily playtime graph";
    property <bool> expanded: root.width > 440px || root.height > 240px;
    property <[PlaytimePoint]> points: expanded ? Widgets.month : Widgets.week;
    VerticalLayout {
        padding: 14px; spacing: 8px;
        CardHeader { item: root.item; }
        HorizontalLayout {
            Text { text: root.expanded ? "Last 30 days" : "Last 7 days"; font-size: Theme.text-metadata; color: Theme.text-secondary; horizontal-stretch: 1; }
            if root.item.lines.length > 0: Text { text: root.item.lines[root.expanded ? 2 : 1].value; font-size: Theme.text-body; font-weight: 600; color: Theme.text; }
        }
        plot := Rectangle {
            vertical-stretch: 1;
            min-height: 48px;
            property <length> cell-width: (self.width - 44px) / max(1, root.points.length);
            Text { x: 0px; y: 0px; width: 40px; height: 14px; horizontal-alignment: left; text: root.expanded ? Widgets.month-peak : Widgets.week-peak; color: Theme.text-muted; font-size: Theme.text-label; }
            Text { x: 0px; width: 40px; height: 14px; y: parent.height - self.height; horizontal-alignment: left; text: "0 min"; color: Theme.text-muted; font-size: Theme.text-label; }
            for point[i] in root.points: Rectangle {
                x: 44px + i * plot.cell-width; width: plot.cell-width; height: plot.height;
                accessible-role: text; accessible-label: point.detail;
                Rectangle { x: 2px; width: max(2px, parent.width - 4px); height: max(2px, point.fraction * (plot.height - 4px)); y: parent.height - self.height; border-radius: 2px; background: point.fraction > 0 ? (hover.has-hover ? Theme.accent-hover : Theme.accent) : Theme.hover; }
                hover := TouchArea {}
                if hover.has-hover: Tooltip { text: point.label + ": " + point.value; x: min(0px, plot.width - i * plot.cell-width - self.width); y: -self.height - 4px; }
            }
        }
        HorizontalLayout {
            Text { text: root.points.length > 0 ? root.points[0].label : ""; color: Theme.text-muted; font-size: Theme.text-label; horizontal-stretch: 1; }
            Text { text: "Today · UTC"; color: Theme.text-muted; font-size: Theme.text-label; }
        }
    }
}

component ListCard inherits Rectangle {
    in property <WidgetView> item;
    in property <bool> first;
    in property <bool> last;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    clip: true;
    accessible-role: groupbox;
    accessible-label: root.item.title;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;
        CardHeader { item: root.item; first: root.first; last: root.last; }
        if root.item.lines.length == 0 && !root.item.loading: Text {
            text: root.item.empty;
            color: Theme.text-muted;
            font-size: Theme.text-metadata;
            wrap: word-wrap;
        }
        for line in root.item.lines: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                Text { text: line.label; color: Theme.text-secondary; font-size: Theme.text-secondary-size; overflow: elide; }
                if line.detail != "": Text { text: line.detail; color: Theme.text-muted; font-size: Theme.text-label; overflow: elide; }
            }
            Text { text: line.value; color: Theme.text; font-size: Theme.text-secondary-size; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
        }
    }
}

component MediaButton inherits IconButton {
    size: 34px;
}

component MediaCard inherits Rectangle {
    in property <WidgetView> item;
    in property <bool> first;
    in property <bool> last;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Media";
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;
        CardHeader { item: root.item; first: root.first; last: root.last; }
        if !Widgets.media-supported: Text { text: "Media controls are available on Windows."; color: Theme.text-muted; font-size: Theme.text-metadata; wrap: word-wrap; }
        if Widgets.media-supported && !Widgets.media-active: Text { text: "Nothing is playing. Apps that publish media sessions to Windows appear here."; color: Theme.text-muted; font-size: Theme.text-metadata; wrap: word-wrap; }
        if Widgets.media-supported && Widgets.media-active: HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: Theme.radius-md;
                background: Theme.hover;
                clip: true;
                if Widgets.media-has-art: Image { width: parent.width; height: parent.height; source: Widgets.media-art; image-fit: cover; image-rendering: smooth; }
                if !Widgets.media-has-art: Icon { path: MediaGlyphs.music; size: 28px; color: Theme.text-muted; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: Widgets.media-title; color: Theme.text; font-size: Theme.text-body; font-weight: 600; overflow: elide; }
                Text { text: Widgets.media-artist; color: Theme.text-secondary; font-size: Theme.text-secondary-size; overflow: elide; }
                Text { text: Widgets.media-source; color: Theme.text-muted; font-size: Theme.text-label; overflow: elide; }
            }
        }
        if Widgets.media-supported && Widgets.media-active: HorizontalLayout {
            spacing: 4px;
            alignment: center;
            MediaButton { icon: MediaGlyphs.previous; label: "Previous track"; enabled: Widgets.media-can-previous; clicked => { Widgets.media-previous(); } }
            MediaButton { icon: Widgets.media-playing ? MediaGlyphs.pause : MediaGlyphs.play; label: Widgets.media-playing ? "Pause" : "Play"; enabled: Widgets.media-can-toggle; clicked => { Widgets.media-toggle(); } }
            MediaButton { icon: MediaGlyphs.next; label: "Next track"; enabled: Widgets.media-can-next; clicked => { Widgets.media-next(); } }
            if Widgets.media-session-count > 1: MediaButton { icon: MediaGlyphs.swap; label: "Switch to another media app"; clicked => { Widgets.media-cycle(); } }
        }
    }
}

/// Responsive, non-overlapping grid; saved dimensions survive narrower windows.
export component WidgetGrid inherits Rectangle {
    property <length> gap: 14px;
    property <length> card-height: 196px;
    property <int> columns: min(6, max(1, floor((self.width + gap) / (150px + gap))));
    changed columns => { Widgets.columns-changed(root.columns); }
    property <length> card-width: (self.width - (columns - 1) * gap) / columns;
    height: Widgets.grid-rows * (card-height + gap);
    for item[i] in Widgets.items: Rectangle {
        x: item.column * (root.card-width + root.gap);
        y: item.row * (root.card-height + root.gap);
        width: item.width * (root.card-width + root.gap) - root.gap;
        height: item.height * (root.card-height + root.gap) - root.gap;
        if item.id == "media": MediaCard { width: parent.width; height: parent.height; item: item; first: i == 0; last: i == Widgets.items.length - 1; }
        if item.id == "playtime": PlaytimeCard { width: parent.width; height: parent.height; item: item; }
        if item.id != "media" && item.id != "playtime": ListCard { width: parent.width; height: parent.height; item: item; first: i == 0; last: i == Widgets.items.length - 1; }
    }
}
