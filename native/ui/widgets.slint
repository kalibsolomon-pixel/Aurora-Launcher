// Home widgets: a small fixed grid with add, remove and reorder. Rust builds
// every card from existing launcher records (gameplay history, instance
// state, system media sessions); cards never poll or compute on their own.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Button, ButtonKind, IconButton, Spinner, Dropdown, Tooltip, KeyboardFocus, FocusRing } from "components.slint";

export struct PlaytimePoint { label: string, value: string, detail: string, fraction: float }

export struct WidgetLine {
    label: string,
    value: string,
    detail: string,
    target-id: string,
    playable: bool,
    favorite: bool,
    unvisited-favorite: bool,
    artwork: image,
}

export struct WidgetView {
    id: string,
    title: string,
    icon: string,
    lines: [WidgetLine],
    empty: string,
    loading: bool,
    column: int, row: int, width: int, height: int,
    requested-width: int, requested-height: int,
}

export struct WidgetChoice {
    id: string,
    title: string,
    icon: string,
}

export global Widgets {
    in property <[WidgetView]> items;
    in property <[WidgetChoice]> available;
    in property <[string]> available-names;
    in-out property <bool> editing: false;
    callback quick-play(string, string);
    callback favorite-server(string, bool);
    callback server-view(bool);
    callback saved-view(bool, bool);
    in-out property <bool> saved-servers;
    in-out property <bool> saved-worlds;
    callback refresh-servers();
    in property <bool> refreshing-servers;
    in-out property <bool> favorites: false;
    callback reset-layout();
    callback add(string);
    callback remove(string);
    callback move(string, int);
    callback place(string, int);
    callback resize(string, int, int);
    callback arrange(string, int, int, int, int, int);
    callback columns-changed(int);
    in-out property <string> active-id;
    in-out property <int> preview-column;
    in-out property <int> preview-row;
    in-out property <int> preview-width;
    in-out property <int> preview-height;
    in property <int> grid-rows;
    in property <[string]> names;
    in property <[string]> positions;
    in-out property <int> playtime-period: 0;
    in property <[PlaytimePoint]> week;
    in property <[PlaytimePoint]> month;
    in property <string> week-peak;
    in property <string> month-peak;
    in property <[PlaytimePoint]> historical;
    in property <string> historical-peak;
    in property <[PlaytimePoint]> month-compact;
    in property <string> month-compact-peak;
    in-out property <int> edit-index: 0;

    // System media session (Windows Global System Media Transport Controls).
    in property <bool> media-supported: false;
    in property <bool> media-active: false;
    in property <string> media-title;
    in property <string> media-artist;
    in property <string> media-source;
    in property <image> media-art;
    in property <bool> media-has-art: false;
    in property <bool> media-playing: false;
    in property <bool> media-can-toggle: false;
    in property <bool> media-can-next: false;
    in property <bool> media-can-previous: false;
    in property <int> media-session-count: 0;
    callback media-toggle();
    callback media-next();
    callback media-previous();
    callback media-cycle();
}

export global MediaGlyphs {
    out property <string> play: "M8 5v14l11-7z";
    out property <string> pause: "M6 19h4V5H6v14zm8-14v14h4V5h-4z";
    out property <string> next: "M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z";
    out property <string> previous: "M6 6h2v12H6zm3.5 6l8.5 6V6z";
    out property <string> music: "M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z";
    out property <string> swap: "M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z";
    out property <string> up: "M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z";
    out property <string> down: "M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z";
    out property <string> tune: "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z";
}

component CardHeader inherits HorizontalLayout {
    in property <WidgetView> item;
    in property <bool> first;
    in property <bool> last;
    spacing: 8px;
    height: 28px;
    Icon { y: (parent.height - self.height) / 2; path: root.item.icon; size: 18px; color: Theme.accent; }
    Text { horizontal-stretch: 1; text: root.item.title; font-size: Theme.text-body; font-weight: 600; color: Theme.text; vertical-alignment: center; overflow: elide; }
    if root.item.loading: Spinner { y: (parent.height - self.height) / 2; size: 14px; }
    if Widgets.editing: IconButton { icon: Icons.close; label: "Remove " + root.item.title; size: 28px; clicked => { Widgets.remove(root.item.id); } }
}

export component WidgetLayoutEditor inherits Rectangle {
    height: layout.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    layout := HorizontalLayout {
        padding: 14px; spacing: 12px;
        Text { horizontal-stretch: 1; text: "Drag headers to move / Drag corners to resize"; wrap: word-wrap; font-size: Theme.text-metadata; color: Theme.text-secondary; vertical-alignment: center; }
        Button { text: "Reset layout"; compact: true; kind: ButtonKind.ghost; clicked => { Widgets.reset-layout(); } }
        if Widgets.available.length > 0: Dropdown { min-width: 122px; model: Widgets.available-names; label: "Add a widget"; current-index: -1; controlled: true; placeholder: "Add widget"; selected(index) => { Widgets.add(Widgets.available[index].id); } }
    }
}

component WidgetGesture inherits Rectangle {
    in property <WidgetView> item;
    in property <bool> resizing;
    in property <int> columns;
    in property <length> column-pitch;
    in property <length> row-pitch;
    property <length> press-x;
    property <length> press-y;
    property <bool> canceled;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: (resizing ? "Resize " : "Move ") + item.title;
    accessible-description: "Arrows move. Shift and arrows resize. Escape cancels.";
    function preview() {
        if root.resizing {
            Widgets.preview-width = clamp(root.item.width + round((touch.mouse-x - root.press-x) / root.column-pitch), 1, root.columns - root.item.column);
            Widgets.preview-height = clamp(root.item.height + round((touch.mouse-y - root.press-y) / root.row-pitch), 1, 3);
        } else {
            Widgets.preview-column = clamp(root.item.column + round((touch.mouse-x - root.press-x) / root.column-pitch), 0, root.columns - root.item.width);
            Widgets.preview-row = clamp(root.item.row + round((touch.mouse-y - root.press-y) / root.row-pitch), 0, 63);
        }
    }
    touch := TouchArea {
        mouse-cursor: root.resizing ? nwse-resize : move;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                focus.pointer-focus(); root.canceled = false;
                root.press-x = self.mouse-x; root.press-y = self.mouse-y;
                Widgets.active-id = root.item.id;
                Widgets.preview-column = root.item.column; Widgets.preview-row = root.item.row;
                Widgets.preview-width = root.item.width; Widgets.preview-height = root.item.height;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && Widgets.active-id == root.item.id {
                root.preview(); Widgets.active-id = "";
                if !root.canceled && (Widgets.preview-column != root.item.column || Widgets.preview-row != root.item.row || Widgets.preview-width != root.item.width || Widgets.preview-height != root.item.height) {
                    Widgets.arrange(root.item.id, Widgets.preview-column, Widgets.preview-row, root.resizing ? Widgets.preview-width : root.item.requested-width, root.resizing ? Widgets.preview-height : root.item.requested-height, root.columns);
                }
            }
            if event.kind == PointerEventKind.cancel { Widgets.active-id = ""; root.canceled = true; }
        }
        moved => { if self.pressed && !root.canceled { root.preview(); } }
    }
    focus := KeyboardFocus {
        key-pressed(event) => {
            if event.text == Key.Escape { root.canceled = true; Widgets.active-id = ""; return accept; }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow {
                let dx = event.text == Key.LeftArrow ? -1 : (event.text == Key.RightArrow ? 1 : 0);
                let dy = event.text == Key.UpArrow ? -1 : (event.text == Key.DownArrow ? 1 : 0);
                let size = root.resizing || event.modifiers.shift;
                Widgets.arrange(root.item.id, root.item.column + (size ? 0 : dx), root.item.row + (size ? 0 : dy), (size ? root.item.width + dx : root.item.requested-width), (size ? root.item.height + dy : root.item.requested-height), root.columns);
                return accept;
            }
            reject
        }
    }
    FocusRing { shown: focus.has-focus && focus.focus-visible; width: parent.width; height: parent.height; }
    if root.resizing: Text { text: "◢"; color: touch.has-hover ? Theme.accent : Theme.text-muted; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
}

component PlaytimePeriods inherits HorizontalLayout {
    spacing: 2px;
    for period[index] in ["7D", "30D", "All"]: Button {
        text: period; compact: true; selected: Widgets.playtime-period == index;
        kind: Widgets.playtime-period == index ? ButtonKind.secondary : ButtonKind.ghost;
        clicked => { Widgets.playtime-period = index; }
    }
}

component PlaytimeCard inherits Rectangle {
    in property <WidgetView> item;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    accessible-role: groupbox;
    accessible-label: "Daily playtime graph";
    property <bool> expanded: Widgets.playtime-period == 1;
    property <bool> all-time: Widgets.playtime-period == 2;
    property <bool> compact-month: expanded && root.width < 320px && Widgets.month-compact.length > 0;
    property <[PlaytimePoint]> points: all-time ? Widgets.historical : (expanded ? (compact-month ? Widgets.month-compact : Widgets.month) : Widgets.week);
    property <string> peak: all-time ? Widgets.historical-peak : (expanded ? (compact-month ? Widgets.month-compact-peak : Widgets.month-peak) : Widgets.week-peak);
    VerticalLayout {
        padding: 14px; spacing: 8px;
        HorizontalLayout {
            spacing: 4px;
            CardHeader { item: root.item; horizontal-stretch: 1; }
            if root.width >= 250px && root.item.lines.length > 0: PlaytimePeriods {}
        }
        if root.width < 250px && root.item.lines.length > 0: PlaytimePeriods {}
        if root.item.lines.length == 0: Text {
            text: root.item.loading ? "Loading playtime..." : root.item.empty;
            color: Theme.text-muted; font-size: Theme.text-metadata;
            vertical-stretch: 1; wrap: word-wrap; vertical-alignment: center;
        }
        if root.item.lines.length > 0: HorizontalLayout {
            spacing: 8px;
            Text { text: root.item.lines[root.all-time ? 3 : (root.expanded ? 2 : 1)].value; font-size: Theme.text-identity; font-weight: 600; color: Theme.text; }
            Text { text: root.all-time ? "All recorded time" : (root.expanded ? "Last 30 days" : "Last 7 days"); font-size: Theme.text-metadata; color: Theme.text-secondary; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
        }
        plot := Rectangle {
            visible: root.item.lines.length > 0 && root.points.length > 0;
            vertical-stretch: 1;
            min-height: root.width < 250px ? 32px : 48px;
            property <length> label-height: root.expanded || root.all-time ? 0px : 16px;
            property <length> cell-width: (self.width - 44px) / max(1, root.points.length);
            Text { x: 0px; y: 0px; width: 40px; height: 14px; horizontal-alignment: left; text: root.peak; color: Theme.text-muted; font-size: Theme.text-label; }
            Text { x: 0px; width: 40px; height: 14px; y: parent.height - self.height; horizontal-alignment: left; text: "0 min"; color: Theme.text-muted; font-size: Theme.text-label; }
            for point[i] in root.points: Rectangle {
                x: 44px + i * plot.cell-width; width: plot.cell-width; height: plot.height - plot.label-height;
                accessible-role: text; accessible-label: point.detail;
                Rectangle { x: 2px; width: max(1px, parent.width - 3px); height: max(2px, point.fraction * max(0px, parent.height - 4px)); y: parent.height - self.height; border-radius: 2px; background: point.fraction > 0 ? (hover.has-hover ? Theme.accent-hover : Theme.accent) : Theme.hover; }
                if !root.expanded && !root.all-time: Text { y: parent.height + 2px; width: parent.width; text: point.label; color: Theme.text-muted; font-size: Theme.text-label; horizontal-alignment: center; overflow: elide; }
                hover := TouchArea {}
                if hover.has-hover: Tooltip { text: point.label + ": " + point.value; x: min(0px, plot.width - i * plot.cell-width - self.width); y: -self.height - 4px; }
            }
        }
        if root.item.lines.length > 0 && root.points.length > 0: HorizontalLayout {
            Text { text: root.width >= 225px && (root.expanded || root.all-time) ? root.points[0].label : ""; color: Theme.text-muted; font-size: Theme.text-label; horizontal-stretch: 1; overflow: elide; }
            Text { text: "Today · UTC"; color: Theme.text-muted; font-size: Theme.text-label; }
        }
    }
}

component ListCard inherits Rectangle {
    in property <WidgetView> item;
    in property <bool> first;
    in property <bool> last;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    clip: true;
    accessible-role: groupbox;
    accessible-label: root.item.title;
    property <bool> servers: root.item.id == "recent-servers";
    property <bool> destinations: root.servers || root.item.id == "recent-worlds";
    function server-view(index: int) {
        Widgets.favorites = index == 1;
        Widgets.saved-servers = index == 2;
        if (index == 2) {
            Widgets.saved-view(false, true);
        } else {
            Widgets.server-view(index == 1);
        }
    }
    VerticalLayout {
        padding: 14px; spacing: 6px;
        CardHeader { item: root.item; first: root.first; last: root.last; }
        if root.servers && root.width >= 260px: HorizontalLayout {
            spacing: 4px;
            Button { text: "Recent"; compact: true; kind: ButtonKind.ghost; selected: !Widgets.favorites && !Widgets.saved-servers; clicked => { root.server-view(0); } }
            Button { text: "Favorites"; compact: true; kind: ButtonKind.ghost; selected: Widgets.favorites; clicked => { root.server-view(1); } }
            Button { text: "Saved"; compact: true; kind: ButtonKind.ghost; selected: Widgets.saved-servers; clicked => { root.server-view(2); } }
            if root.item.lines.length > 0: Button { icon: Icons.refresh; compact: true; kind: ButtonKind.ghost; accessible-description-text: "Refresh server status"; enabled: !Widgets.refreshing-servers; clicked => { Widgets.refresh-servers(); } }
        }
        if root.servers && root.width < 260px: HorizontalLayout {
            spacing: 4px;
            Dropdown {
                min-width: 0px; min-height: 30px; horizontal-stretch: 1;
                model: ["Recent", "Favorites", "Saved"];
                label: "Server view"; controlled: true;
                current-index: Widgets.saved-servers ? 2 : (Widgets.favorites ? 1 : 0);
                selected(index) => { root.server-view(index); }
            }
            if root.item.lines.length > 0: IconButton {
                icon: Icons.refresh; size: 30px; label: "Refresh server status";
                enabled: !Widgets.refreshing-servers;
                clicked => { Widgets.refresh-servers(); }
            }
        }
        if root.destinations && !root.servers: HorizontalLayout {
            spacing: 4px;
            Button { text: "Recent"; compact: true; kind: ButtonKind.ghost; selected: !Widgets.saved-worlds; clicked => { Widgets.saved-worlds = false; Widgets.saved-view(true, false); } }
            Button { text: "Saved"; compact: true; kind: ButtonKind.ghost; selected: Widgets.saved-worlds; clicked => { Widgets.saved-worlds = true; Widgets.saved-view(true, true); } }
        }
        if root.item.loading && root.item.lines.length == 0: Text {
            text: "Loading destinations…"; color: Theme.text-muted; font-size: Theme.text-metadata;
            vertical-stretch: 1; vertical-alignment: center; horizontal-alignment: center;
        }
        if root.item.lines.length == 0 && !root.item.loading: Text {
            vertical-stretch: 1; text: root.item.empty; color: Theme.text-muted; font-size: Theme.text-metadata;
            wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
        }
        if root.item.lines.length > 0: ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                alignment: start;
                for line[index] in root.item.lines: Rectangle {
                    height: root.destinations ? 48px : 36px;
                    if index > 0: Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        spacing: 4px;
                        if line.artwork.width > 0 && root.width >= 240px: Image {
                            source: line.artwork; width: 28px; height: 28px; y: (parent.height - self.height) / 2; image-fit: contain;
                        }
                        if root.destinations && line.artwork.width == 0 && root.width >= 240px: Icon {
                            path: root.item.icon; size: 28px; y: (parent.height - self.height) / 2; color: Theme.text-muted;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text { text: line.label; color: Theme.text-secondary; font-size: Theme.text-secondary-size; overflow: elide; }
                            if line.detail != "": Text { text: root.destinations ? line.value + " · " + line.detail : line.detail; color: Theme.text-muted; font-size: Theme.text-label; overflow: elide; }
                        }
                        if !root.destinations: Text { text: line.value; color: Theme.text; font-size: Theme.text-secondary-size; vertical-alignment: center; }
                        if root.servers && line.target-id != "": IconButton {
                            icon: line.favorite ? Icons.star-filled : Icons.star;
                            label: (line.favorite ? "Remove favorite " : "Favorite ") + line.label;
                            size: 30px; y: (parent.height - self.height) / 2;
                            clicked => { Widgets.favorite-server(line.target-id, !line.favorite); }
                        }
                        if root.destinations && line.target-id != "": IconButton {
                            icon: Icons.play; label: "Quick Play " + line.label;
                            size: 30px; y: (parent.height - self.height) / 2;
                            enabled: line.playable && !Widgets.editing;
                            clicked => { Widgets.quick-play(root.servers ? (Widgets.saved-servers ? "saved-server" : "server") : (Widgets.saved-worlds ? "saved-world" : "world"), line.target-id); }
                        }
                    }
                }
            }
        }
    }
}

component MediaButton inherits IconButton {
    size: 34px;
}

component MediaCard inherits Rectangle {
    in property <WidgetView> item;
    in property <bool> first;
    in property <bool> last;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Media";
    CardHeader { x: 14px; y: 14px; width: root.width - 28px; item: root.item; first: root.first; last: root.last; }
    body := Rectangle {
        x: 14px; y: 52px; width: root.width - 28px; height: max(0px, root.height - 66px);
        property <bool> stacked: root.width < 240px || (root.height >= 280px && root.width < 480px);
        property <bool> compact: root.width < 240px && root.height < 280px;
        property <length> details-height: compact ? 38px : 68px;
        property <length> art-size: stacked ? min(self.width, clamp((self.height - details-height - 56px) * 0.75, 32px, 224px)) : clamp(self.height - 64px, 48px, 224px);
        property <length> content-height: stacked ? art-size + 10px + details-height : max(art-size, details-height);
        property <length> content-y: max(0px, (self.height - 44px - content-height) / 2);
        if !Widgets.media-supported || !Widgets.media-active: Text {
            width: parent.width; height: parent.height;
            text: !Widgets.media-supported ? "Media controls are available on Windows." : "Nothing is playing.";
            color: Theme.text-muted; font-size: Theme.text-metadata;
            wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
        }
        if Widgets.media-supported && Widgets.media-active: Rectangle {
            x: body.stacked ? (body.width - self.width) / 2 : 0px;
            y: body.content-y + (body.stacked ? 0px : (body.content-height - self.height) / 2);
            width: body.art-size; height: self.width;
            border-radius: Theme.radius-md; background: Theme.hover; clip: true;
            if Widgets.media-has-art: Image { width: parent.width; height: parent.height; source: Widgets.media-art; image-fit: cover; image-rendering: smooth; }
            if !Widgets.media-has-art: Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; path: MediaGlyphs.music; size: min(48px, parent.width * 0.5); color: Theme.text-muted; }
        }
        if Widgets.media-supported && Widgets.media-active: VerticalLayout {
            x: body.stacked ? 0px : body.art-size + 16px;
            y: body.content-y + (body.stacked ? body.art-size + 10px : (body.content-height - body.details-height) / 2);
            width: body.stacked ? body.width : max(0px, body.width - body.art-size - 16px);
            height: body.details-height; alignment: center; spacing: 2px;
            Text { text: Widgets.media-title; color: Theme.text; font-size: root.height >= 280px ? Theme.text-identity : Theme.text-body; font-weight: 600; overflow: elide; horizontal-alignment: body.stacked ? center : left; }
            Text { text: Widgets.media-artist; color: Theme.text-secondary; font-size: Theme.text-secondary-size; overflow: elide; horizontal-alignment: body.stacked ? center : left; }
            if !body.compact: Text { text: Widgets.media-source; color: Theme.text-muted; font-size: Theme.text-label; overflow: elide; horizontal-alignment: body.stacked ? center : left; }
        }
        if Widgets.media-supported && Widgets.media-active: HorizontalLayout {
            y: parent.height - 34px; height: 34px; width: parent.width; spacing: 4px; alignment: center;
            MediaButton { size: min(34px, (body.width - 12px) / (Widgets.media-session-count > 1 ? 4 : 3)); icon: MediaGlyphs.previous; label: "Previous track"; enabled: Widgets.media-can-previous; clicked => { Widgets.media-previous(); } }
            MediaButton { size: min(34px, (body.width - 12px) / (Widgets.media-session-count > 1 ? 4 : 3)); icon: Widgets.media-playing ? MediaGlyphs.pause : MediaGlyphs.play; label: Widgets.media-playing ? "Pause" : "Play"; enabled: Widgets.media-can-toggle; clicked => { Widgets.media-toggle(); } }
            MediaButton { size: min(34px, (body.width - 12px) / (Widgets.media-session-count > 1 ? 4 : 3)); icon: MediaGlyphs.next; label: "Next track"; enabled: Widgets.media-can-next; clicked => { Widgets.media-next(); } }
            if Widgets.media-session-count > 1: MediaButton { size: min(34px, (body.width - 12px) / (Widgets.media-session-count > 1 ? 4 : 3)); icon: MediaGlyphs.swap; label: "Switch to another media app"; clicked => { Widgets.media-cycle(); } }
        }
    }
}

/// Responsive, non-overlapping grid; saved dimensions survive narrower windows.
export component WidgetGrid inherits Rectangle {
    property <length> gap: 14px;
    property <length> card-height: 196px;
    property <int> columns: min(6, max(1, floor((self.width + gap) / (150px + gap))));
    changed columns => { Widgets.columns-changed(root.columns); }
    property <length> card-width: (self.width - (columns - 1) * gap) / columns;
    height: (Widgets.editing ? max(Widgets.grid-rows + 2, Widgets.active-id != "" ? Widgets.preview-row + Widgets.preview-height + 1 : 3) : Widgets.grid-rows) * (card-height + gap);
    if Widgets.editing: Rectangle {
        for row in max(3, Widgets.grid-rows + 2): Rectangle {
            y: row * (root.card-height + root.gap);
            for col in root.columns: Rectangle {
                x: col * (root.card-width + root.gap); width: root.card-width; height: root.card-height;
                border-width: 1px; border-color: Theme.border.with-alpha(0.35); border-radius: Theme.radius-lg;
            }
        }
    }
    for item[i] in Widgets.items: Rectangle {
        x: item.column * (root.card-width + root.gap);
        y: item.row * (root.card-height + root.gap);
        width: item.width * (root.card-width + root.gap) - root.gap;
        height: item.height * (root.card-height + root.gap) - root.gap;
        if item.id == "media": MediaCard { width: parent.width; height: parent.height; item: item; first: i == 0; last: i == Widgets.items.length - 1; }
        if item.id == "playtime": PlaytimeCard { width: parent.width; height: parent.height; item: item; }
        if item.id != "media" && item.id != "playtime": ListCard { width: parent.width; height: parent.height; item: item; first: i == 0; last: i == Widgets.items.length - 1; }
        if Widgets.editing: WidgetGesture { x: 8px; y: 8px; width: parent.width - 54px; height: 40px; item: item; columns: root.columns; column-pitch: root.card-width + root.gap; row-pitch: root.card-height + root.gap; }
        if Widgets.editing: WidgetGesture { x: parent.width - 32px; y: parent.height - 32px; width: 32px; height: 32px; resizing: true; item: item; columns: root.columns; column-pitch: root.card-width + root.gap; row-pitch: root.card-height + root.gap; }
    }
    if Widgets.editing && Widgets.active-id != "": Rectangle {
        x: Widgets.preview-column * (root.card-width + root.gap);
        y: Widgets.preview-row * (root.card-height + root.gap);
        width: Widgets.preview-width * (root.card-width + root.gap) - root.gap;
        height: Widgets.preview-height * (root.card-height + root.gap) - root.gap;
        border-width: 2px; border-color: Theme.accent; border-radius: Theme.radius-lg;
        background: Theme.accent.with-alpha(0.08);
    }

    for item in Widgets.items: Rectangle {
        visible: Widgets.editing && Widgets.active-id != "" && Widgets.active-id != item.id
            && Widgets.preview-column < item.column + item.width
            && item.column < Widgets.preview-column + Widgets.preview-width
            && Widgets.preview-row < item.row + item.height
            && item.row < Widgets.preview-row + Widgets.preview-height;
        x: item.column * (root.card-width + root.gap);
        y: item.row * (root.card-height + root.gap);
        width: item.width * (root.card-width + root.gap) - root.gap;
        height: item.height * (root.card-height + root.gap) - root.gap;
        border-width: 2px; border-color: Theme.error; border-radius: Theme.radius-lg;
    }

}
